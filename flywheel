    installation_json="$(installation_receipt_context)"
    installation_status="$(probe_value "$installation_json" '["status"]')"
    if [[ "$installation_status" == "recorded" ]]; then
        installed_guest_root="$(probe_value "$installation_json" '["source"]["guest_root"]')"
        installed_head="$(probe_value "$installation_json" '["source"]["head"]')"
        installed_tree="$(probe_value "$installation_json" '["source"]["tree"]')"
        installed_authority_kind="$(probe_value "$installation_json" '["authority"]["kind"]')"
        installed_authority_sha256="$(probe_value "$installation_json" '["authority"]["sha256"]')"
    fi
    root="$(find_source_root 2>/dev/null || true)"
    if [[ -n "$root" ]]; then
        head="$(safe_git -C "$root" rev-parse HEAD 2>/dev/null || true)"
        tree="$(safe_git -C "$root" rev-parse 'HEAD^{tree}' 2>/dev/null || true)"
        authority="$root/config/flywheel-partial-safe-allowlist.json"
        repository_control="$root/scripts/flywheel-repository-control.py"
        if [[ -f "$root/config/flywheel-license-clearance.json" ]]; then
            authority="$root/config/flywheel-license-clearance.json"
        fi
        if git_index_flags_safe "$root" \
            && tracked_regular_files_match_head "$root" "$head" \
            && safe_git -C "$root" diff --cached --quiet --no-ext-diff --no-textconv \
            && [[ -z "$(safe_git -C "$root" ls-files --others --exclude-standard)" ]]; then
            source_clean="true"
        fi
    fi
    if [[ "$(probe_value "$probe" '["contract"]["matches"]')" == "true" \
        && "$status" == "Running" && "$installation_status" == "recorded" ]]; then
        set +e
        qualification_json="$(qualification_command \
            "$installed_guest_root" "$installed_head" "$installed_tree" 2>/dev/null)"
        doctor_json="$(doctor_for_installation \
            "$installed_guest_root" \
            "$installed_head" \
            "$installed_tree" \
            "$installed_authority_kind" \
            "$installed_authority_sha256" \
            --json 2>/dev/null)"
        set -e
    fi
    status_json="$(/usr/bin/python3 -I - "$probe" "$root" "$head" "$tree" "$source_clean" "$installation_json" "$authority" "$repository_control" "$ROLLOUT_RECEIPT" "$qualification_json" "$doctor_json" <<'PY'
import hashlib
import hmac
import json
import os
import pathlib
import re
import stat
import subprocess
import sys

(
    vm_probe_raw,
    source_root,
    source_head,
    source_tree,
    source_clean_raw,
    installation_context_raw,
    authority_path,
    repository_control_path,
    rollout_receipt_path,
    qualification_raw,
    doctor_raw,
) = sys.argv[1:]

vm = json.loads(vm_probe_raw)
vm_status = vm["status"]
vm["healthy"] = bool(
    vm.get("query_status") == "ok"
    and vm.get("exists") is True
    and vm_status == "Running"
    and vm.get("contract", {}).get("matches") is True
)

def stable_read(path, maximum_bytes, label):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise ValueError(f"{label} must be a regular file")
        if before.st_size > maximum_bytes:
            raise ValueError(f"{label} exceeds {maximum_bytes} bytes")
        chunks = []
        remaining = before.st_size
        while remaining:
            block = os.read(descriptor, min(65536, remaining))
            if not block:
                raise ValueError(f"{label} ended while being read")
            chunks.append(block)
            remaining -= len(block)
        if os.read(descriptor, 1):
            raise ValueError(f"{label} grew while being read")
        after = os.fstat(descriptor)
        before_identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
        after_identity = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        if before_identity != after_identity:
            raise ValueError(f"{label} changed while being read")
        return b"".join(chunks)
    finally:
        os.close(descriptor)

def read_json(path, label):
    if not path:
        return None, None
    try:
        raw = stable_read(path, 4 * 1024 * 1024, label)
        return json.loads(raw), raw
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        return None, None

def safe_git(root, *arguments):
    environment = {
        "HOME": os.environ.get("HOME", "/"),
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "TMPDIR": os.environ.get("TMPDIR", "/tmp"),
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_ATTR_NOSYSTEM": "1",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_CONFIG_SYSTEM": os.devnull,
        "GIT_EXTERNAL_DIFF": "",
        "GIT_LITERAL_PATHSPECS": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_TERMINAL_PROMPT": "0",
    }
    completed = subprocess.run(
        [
            "/usr/bin/git",
            "-c", "core.fsmonitor=false",
            "-c", "core.untrackedCache=false",
            "-c", f"core.hooksPath={os.devnull}",
            "-c", "diff.external=",
            "-c", "interactive.diffFilter=",
            "-C", root,
            *arguments,
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=15,
        env=environment,
    )
    if completed.returncode != 0 or len(completed.stdout) > 16 * 1024 * 1024:
        raise ValueError("repository receipt validator Git trust check failed")
    return completed.stdout

def exact_validator_bytes(root, head, control_path):
    expected_path = pathlib.Path(root) / "scripts" / "flywheel-repository-control.py"
    if pathlib.Path(control_path) != expected_path:
        raise ValueError("repository receipt validator path is not canonical")
    flags = safe_git(root, "ls-files", "-v", "-z", "--cached")
    unsafe = []
    for record in (item for item in flags.split(b"\0") if item):
        if len(record) < 3 or record[1:2] != b" " or record[:1] != b"H":
            unsafe.append(record[2:] if len(record) >= 3 else record)
    if unsafe:
        raise ValueError("repository receipt validator source has unsafe index flags")
    if safe_git(root, "rev-parse", "HEAD").decode().strip() != head:
        raise ValueError("repository receipt validator source head changed")
    control_raw = stable_read(control_path, 4 * 1024 * 1024, "repository receipt validator")
    committed_raw = safe_git(root, "show", f"{head}:scripts/flywheel-repository-control.py")
    if control_raw != committed_raw:
        raise ValueError("repository receipt validator differs from the committed source blob")
    if safe_git(root, "rev-parse", "HEAD").decode().strip() != head:
        raise ValueError("repository receipt validator source changed during validation")
    return control_raw

def invalid_receipt(schema, error):
    return {"schema": schema, "status": "invalid", "error": error}

def load_receipt(raw, schema):
    if not raw:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as error:
        raise ValueError("receipt is not valid JSON") from error
    if not isinstance(value, dict) or value.get("schema") != schema:
        raise ValueError("receipt schema is invalid")
    return value

def verify_receipt_digest(value):
    declared = value.get("receipt_sha256")
    if not isinstance(declared, str) or re.fullmatch(r"[0-9a-f]{64}", declared) is None:
        raise ValueError("receipt digest is missing or malformed")
    canonical_value = dict(value)
    canonical_value.pop("receipt_sha256", None)
    canonical = (
        json.dumps(canonical_value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
        + "\n"
    ).encode()
    observed = hashlib.sha256(canonical).hexdigest()
    if not hmac.compare_digest(declared, observed):
        raise ValueError("receipt digest does not match its canonical contents")

