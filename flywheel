#!/usr/bin/env bash
set -euo pipefail
shopt -s lastpipe 2>/dev/null || true
umask 022

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/${BASH_SOURCE[0]##*/}"
STATE_HOME="${FLYWHEEL_STATE_HOME:-$HOME/.local/share/agent-flywheel}"
SOURCE_POINTER="$STATE_HOME/source-root"
INSTALL_RECEIPT="$STATE_HOME/installation.json"
VM_NAME="${FLYWHEEL_VM_NAME:-agent-flywheel-ubuntu2404}"
CANONICAL_VM_NAME="agent-flywheel-ubuntu2404"
VM_TEMPLATE_RELATIVE="config/flywheel-lima.yaml"
HEAVY_RUN="${FLYWHEEL_HEAVY_RUN:-$HOME/.local/bin/codex-heavy-run}"
LIMACTL="${FLYWHEEL_LIMACTL:-$(command -v limactl 2>/dev/null || true)}"
ROLLOUT_RECEIPT="${FLYWHEEL_ROLLOUT_RECEIPT:-}"
PILOT_RECEIPT=""
PILOT_SOURCE=""
TARGET_REPOSITORY=""
QUIET=0
JSON=0
NO_GUM=0
TEMP_ROOT=""
LOCK_DIR=""

cleanup() {
    if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
    if [[ -n "$TEMP_ROOT" && -d "$TEMP_ROOT" ]]; then
        rm -rf -- "$TEMP_ROOT"
    fi
}
trap cleanup EXIT INT TERM HUP

usage() {
    cat <<'USAGE'
Usage:
  flywheel mac install
  flywheel start
  flywheel status [--json] [--rollout-receipt FILE]
  flywheel doctor [--json]
  flywheel stop
  flywheel capabilities --json
  flywheel robot-docs guide
  flywheel repository inspect PATH [--json]
  flywheel repository eligibility PATH --pilot-receipt FILE --pilot-source PATH --target-repository OWNER/REPOSITORY [--json]
  flywheel rollout plan INVENTORY.json [--json]

Options:
  --json                  machine-readable read-side output
  --rollout-receipt FILE  attach one repository rollout evidence receipt
  --pilot-receipt FILE    sealed Ops synthetic-pilot receipt
  --pilot-source PATH     exact clean Ops source checkout bound by the pilot
  --target-repository ID  expected GitHub target as OWNER/REPOSITORY
  --quiet                 suppress non-error progress
  --no-gum                disable optional gum formatting
  -h, --help              show this help

Exit codes:
  0  command completed successfully
  1  status or doctor completed and found an unhealthy state
  2  invalid invocation or safety refusal
  3  required host environment is unavailable
  5  another operation owns the requested state

The Mac command manages the supported Ubuntu VM. Native macOS is not treated
as an ACFS installation. When the exact license-clearance receipt is present,
the command commissions the 26 newly eligible modules while preserving the
independent Agent Mail C5 and PFR qualification holds.
USAGE
}

info() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
        gum style --foreground 39 "→ $*"
    else
        printf '→ %s\n' "$*"
    fi
}

ok() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
        gum style --foreground 42 "✓ $*"
    else
        printf '✓ %s\n' "$*"
    fi
}

die() {
    local code="$1"
    shift
    printf 'Flywheel: %s\n' "$*" >&2
    exit "$code"
}

find_source_root() {
    local self_dir="${SELF%/*}"
    local candidate="${FLYWHEEL_SOURCE_REPO:-}"
    if [[ -z "$candidate" && -f "$self_dir/acfs.manifest.yaml" ]]; then
        candidate="$self_dir"
    fi
    if [[ -z "$candidate" && -f "$SOURCE_POINTER" && ! -L "$SOURCE_POINTER" ]]; then
        IFS= read -r candidate <"$SOURCE_POINTER"
    fi
    [[ -n "$candidate" && "$candidate" == /* && -f "$candidate/acfs.manifest.yaml" ]] \
        || return 1
    (cd "$candidate" && pwd -P)
}

source_root() {
    find_source_root \
        || die 3 "cannot locate the ACFS source checkout; set FLYWHEEL_SOURCE_REPO"
}

require_mac_tools() {
    [[ "$(uname -s)" == "Darwin" ]] \
        || die 3 "Mac lifecycle commands require macOS"
    [[ -n "$LIMACTL" && -x "$LIMACTL" ]] \
        || die 3 "Lima is required; install it, then retry the same command"
}

vm_probe() {
    local inventory=""
    if ! inventory="$("$LIMACTL" list --json 2>/dev/null)"; then
        python3 - "$VM_NAME" "$CANONICAL_VM_NAME" <<'PY'
import json
import sys

print(json.dumps({
    "query_status": "error",
    "exists": None,
    "name": sys.argv[1],
    "status": "Unavailable",
    "resources": None,
    "contract": {
        "id": "agent-flywheel.mac-vm/v1",
        "matches": False,
        "expected_name": sys.argv[2],
    },
    "mismatches": ["inventory_query_failed"],
}, sort_keys=True, separators=(",", ":")))
PY
        return 0
    fi
    python3 - "$VM_NAME" "$CANONICAL_VM_NAME" "$inventory" <<'PY'
import json
import sys

selected_name, expected_name, raw = sys.argv[1:]
expected = {
    "name": expected_name,
    "vm_type": "vz",
    "architecture": "aarch64",
    "cpus": 6,
    "memory_bytes": 10 * 1024 ** 3,
    "disk_bytes": 68 * 1024 ** 3,
    "image": {
        "location": "https://cloud-images.ubuntu.com/releases/24.04/release-20260814/ubuntu-24.04-server-cloudimg-arm64.img",
        "digest": "sha256:4a281a921b8d7db952895ab619736f10efe9f63e111fa5b5779ed18f023818aa",
    },
    "plain": True,
    "mount_count": 0,
    "exposed_guest_ports": False,
}
try:
    items = [json.loads(line) for line in raw.splitlines() if line.strip()]
    if any(not isinstance(item, dict) for item in items):
        raise ValueError("inventory item is not an object")
except (json.JSONDecodeError, ValueError):
    print(json.dumps({
        "query_status": "error",
        "exists": None,
        "name": selected_name,
        "status": "Unavailable",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": ["inventory_response_invalid"],
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

matches = [item for item in items if item.get("name") == selected_name]
if len(matches) > 1:
    print(json.dumps({
        "query_status": "error",
        "exists": None,
        "name": selected_name,
        "status": "Unavailable",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": ["inventory_name_duplicated"],
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

if not matches:
    mismatches = ["vm_missing"]
    if selected_name != expected_name:
        mismatches.insert(0, "name")
    print(json.dumps({
        "query_status": "ok",
        "exists": False,
        "name": selected_name,
        "status": "Missing",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": mismatches,
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

item = matches[0]
config = item.get("config") if isinstance(item.get("config"), dict) else {}
images = config.get("images") if isinstance(config.get("images"), list) else []
image = images[0] if len(images) == 1 and isinstance(images[0], dict) else {}
mounts = config.get("mounts", [])
mount_count = len(mounts) if isinstance(mounts, list) else None
port_forwards = config.get("portForwards", [])
if isinstance(port_forwards, list):
    exposed_guest_ports = any(
        not isinstance(rule, dict) or rule.get("ignore") is not True
        for rule in port_forwards
    )
else:
    exposed_guest_ports = True
resources = {
    "vm_type": item.get("vmType"),
    "architecture": item.get("arch"),
    "cpus": item.get("cpus"),
    "memory_bytes": item.get("memory"),
    "disk_bytes": item.get("disk"),
    "image": {
        "location": image.get("location"),
        "digest": image.get("digest"),
    },
    "plain": config.get("plain"),
    "mount_count": mount_count,
    "exposed_guest_ports": exposed_guest_ports,
}
mismatches = []
if selected_name != expected_name:
    mismatches.append("name")
for field in ("vm_type", "architecture", "cpus", "memory_bytes", "disk_bytes", "plain", "mount_count", "exposed_guest_ports"):
    if resources[field] != expected[field]:
        mismatches.append(field)
if resources["image"] != expected["image"]:
    mismatches.append("image")
print(json.dumps({
    "query_status": "ok",
    "exists": True,
    "name": selected_name,
    "status": item.get("status", "Unknown"),
    "resources": resources,
    "contract": {
        "id": "agent-flywheel.mac-vm/v1",
        "matches": not mismatches,
        "expected": expected,
    },
    "mismatches": mismatches,
}, sort_keys=True, separators=(",", ":")))
PY
}

probe_value() {
    python3 -c 'import json,sys; value=json.loads(sys.argv[1]); result=value'"$2"'; print(json.dumps(result) if isinstance(result, (dict, list, bool)) or result is None else result)' "$1"
}

ensure_running() {
    local probe=""
    local query_status=""
    local exists=""
    local status=""
    local contract_matches=""
    local mismatches=""
    local root=""
    local template=""
    [[ "$VM_NAME" == "$CANONICAL_VM_NAME" ]] \
        || die 2 "unsupported VM name $VM_NAME; the Mac lifecycle contract requires $CANONICAL_VM_NAME"
    probe="$(vm_probe)"
    query_status="$(probe_value "$probe" '["query_status"]')"
    [[ "$query_status" == "ok" ]] \
        || die 3 "cannot query Lima VM inventory; no VM was created or changed"
    exists="$(probe_value "$probe" '["exists"]')"
    status="$(probe_value "$probe" '["status"]')"
    contract_matches="$(probe_value "$probe" '["contract"]["matches"]')"
    mismatches="$(probe_value "$probe" '["mismatches"]')"
    if [[ "$exists" == "false" ]]; then
        [[ -x "$HEAVY_RUN" ]] \
            || die 3 "the Mac heavy-work safety guard is unavailable; restore $HEAVY_RUN, then run flywheel start"
        root="$(source_root)"
        template="$root/$VM_TEMPLATE_RELATIVE"
        [[ -f "$template" && ! -L "$template" ]] \
            || die 3 "the canonical Lima template is unavailable or unsafe: $template"
        git -C "$root" ls-files --error-unmatch -- "$VM_TEMPLATE_RELATIVE" >/dev/null 2>&1 \
            || die 2 "the canonical Lima template is not tracked by the exact source checkout; no VM was created"
        git -C "$root" diff --quiet -- "$VM_TEMPLATE_RELATIVE" \
            && git -C "$root" diff --cached --quiet -- "$VM_TEMPLATE_RELATIVE" \
            || die 2 "the canonical Lima template has uncommitted drift; no VM was created"
        "$LIMACTL" validate "$template" >/dev/null \
            || die 2 "the canonical Lima template failed validation; no VM was created"
        info "Creating the isolated Ubuntu Flywheel"
        "$HEAVY_RUN" --stateful -- "$LIMACTL" start --tty=false --name="$VM_NAME" "$template" \
            || die 3 "Lima could not create and start $VM_NAME"
    else
        [[ "$contract_matches" == "true" ]] \
            || die 2 "existing VM $VM_NAME does not match the Flywheel contract ($mismatches); it was not changed"
        if [[ "$status" == "Running" ]]; then
            return 0
        fi
        [[ "$status" == "Stopped" ]] \
            || die 2 "existing VM $VM_NAME is $status; it was not changed"
        [[ -x "$HEAVY_RUN" ]] \
            || die 3 "the Mac heavy-work safety guard is unavailable; restore $HEAVY_RUN, then run flywheel start"
        info "Starting the Ubuntu Flywheel"
        "$HEAVY_RUN" --stateful -- "$LIMACTL" start --tty=false "$VM_NAME" \
            || die 3 "Lima could not start $VM_NAME"
    fi
    probe="$(vm_probe)"
    query_status="$(probe_value "$probe" '["query_status"]')"
    exists="$(probe_value "$probe" '["exists"]')"
    status="$(probe_value "$probe" '["status"]')"
    contract_matches="$(probe_value "$probe" '["contract"]["matches"]')"
    mismatches="$(probe_value "$probe" '["mismatches"]')"
    [[ "$query_status" == "ok" ]] \
        || die 3 "Lima started work but the VM inventory re-query failed; inspect $VM_NAME before retrying"
    [[ "$exists" == "true" ]] \
        || die 3 "Lima reported success but $VM_NAME is still absent"
    [[ "$contract_matches" == "true" ]] \
        || die 2 "created or started VM $VM_NAME does not match the Flywheel contract ($mismatches); it was left unchanged for inspection"
    [[ "$status" == "Running" ]] \
        || die 3 "Lima reported success but $VM_NAME is $status"
}

acquire_lifecycle_lock() {
    local operation="$1"
    local lock_root="$STATE_HOME/locks"
    mkdir -p "$lock_root"
    chmod 0700 "$STATE_HOME" "$lock_root"
    LOCK_DIR="$lock_root/lifecycle.lock"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        die 5 "another Flywheel lifecycle operation is running; retry flywheel $operation after it finishes"
    fi
}

sha256_file() {
    shasum -a 256 "$1" | awk '{print $1}'
}

publish_private_file() {
    local source="$1"
    local destination="$2"
    local parent="${destination%/*}"
    local name="${destination##*/}"
    local candidate=""
    [[ -d "$parent" && ! -L "$parent" ]] \
        || die 3 "state directory is unavailable or unsafe: $parent"
    candidate="$(mktemp "$parent/.$name.XXXXXXXX")"
    install -m 0600 "$source" "$candidate"
    mv -f "$candidate" "$destination"
}

stage_source() {
    local root="$1"
    local head="$2"
    local short="${head:0:12}"
    local bundle="$TEMP_ROOT/acfs-$short.bundle"
    local bundle_sha256=""
    local guest_bundle="/var/tmp/agent-flywheel-acfs-$head.bundle"
    local guest_root="/opt/agent-flywheel-acfs-$head"

    git -C "$root" bundle create "$bundle" HEAD
    bundle_sha256="$(sha256_file "$bundle")"
    "$LIMACTL" copy --backend=scp "$bundle" "$VM_NAME:$guest_bundle" >/dev/null
    "$LIMACTL" shell "$VM_NAME" -- bash -lc '
set -euo pipefail
guest_bundle="$1"
guest_root="$2"
head="$3"
if [[ ! -d "$guest_root/.git" ]]; then
    sudo git clone --quiet "$guest_bundle" "$guest_root"
fi
test "$(sudo git -C "$guest_root" rev-parse HEAD)" = "$head"
sudo git -C "$guest_root" diff --quiet
sudo git -C "$guest_root" diff --cached --quiet
test -z "$(sudo git -C "$guest_root" ls-files --others --exclude-standard)"
' -- "$guest_bundle" "$guest_root" "$head"
    printf '%s\t%s\n' "$guest_root" "$bundle_sha256"
}

write_install_receipt() {
    local root="$1"
    local head="$2"
    local tree="$3"
    local guest_root="$4"
    local bundle_sha256="$5"
    local authority="$root/config/flywheel-partial-safe-allowlist.json"
    local authority_sha256=""
    local candidate="$TEMP_ROOT/installation.json"
    if [[ -f "$root/config/flywheel-license-clearance.json" ]]; then
        authority="$root/config/flywheel-license-clearance.json"
    fi
    authority_sha256="$(sha256_file "$authority")"
    python3 - "$head" "$tree" "$guest_root" "$bundle_sha256" "$authority_sha256" "$authority" <<'PY' >"$candidate"
import datetime
import json
import sys

head, tree, guest_root, bundle_sha256, authority_sha256, authority_path = sys.argv[1:]
with open(authority_path, encoding="utf-8") as handle:
    authority = json.load(handle)
license_cleared = authority.get("schema") == "agent-flywheel.license-clearance/v1"
if license_cleared:
    commissioning = authority["commissioning"]
    claim = commissioning["claim"]
    approved = len(commissioning["resolved_modules"])
    cleared = authority["license_gate"]["cleared_count"]
    pending = authority["license_gate"]["pending_count"]
    authority_kind = "license_clearance"
else:
    claim = "PARTIAL_SAFE"
    approved = len(authority["allowed_resolved_modules"])
    cleared = 0
    pending = authority["held_exclusions"]["count"]
    authority_kind = "partial_safe_allowlist"
print(json.dumps({
    "schema": "agent-flywheel.installation/v1",
    "claim": claim,
    "installed_at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat(),
    "source": {"head": head, "tree": tree, "guest_root": guest_root},
    "bundle": {"sha256": bundle_sha256},
    "authority": {"kind": authority_kind, "sha256": authority_sha256},
    "modules": {
        "approved": approved,
        "licensing_cleared": cleared,
        "licensing_pending": pending,
    },
}, sort_keys=True, separators=(",", ":")))
PY
    publish_private_file "$candidate" "$INSTALL_RECEIPT"
}

install_command() {
    require_mac_tools
    local root=""
    local source_cli=""
    local installed_cli="$HOME/.local/bin/flywheel"
    local head=""
    local tree=""
    local guest_root=""
    local bundle_sha256=""
    local stage_result=""
    root="$(source_root)"
    source_cli="$root/flywheel"
    [[ -f "$source_cli" && ! -L "$source_cli" ]] \
        || die 2 "source checkout has no regular flywheel launcher"
    git -C "$root" diff --quiet \
        || die 2 "source checkout has uncommitted changes; commit or preserve them before flywheel mac install"
    git -C "$root" diff --cached --quiet \
        || die 2 "source checkout has staged changes; commit or preserve them before flywheel mac install"
    [[ -z "$(git -C "$root" ls-files --others --exclude-standard)" ]] \
        || die 2 "source checkout has untracked files; preserve them before flywheel mac install"
    head="$(git -C "$root" rev-parse HEAD)"
    tree="$(git -C "$root" rev-parse 'HEAD^{tree}')"

    acquire_lifecycle_lock "mac install"
    TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/flywheel-install.XXXXXXXX")"
    ensure_running
    info "Staging exact source $head"
    stage_result="$(stage_source "$root" "$head")"
    IFS=$'\t' read -r guest_root bundle_sha256 <<<"$stage_result"
    [[ -n "$guest_root" && -n "$bundle_sha256" ]] \
        || die 3 "exact-source staging produced no identity; rerun flywheel mac install"
    if [[ -f "$root/config/flywheel-license-clearance.json" ]]; then
        info "Commissioning the license-cleared profile with independent holds preserved"
    else
        info "Commissioning the eight-module PARTIAL_SAFE profile"
    fi
    "$HEAVY_RUN" --stateful -- "$LIMACTL" shell "$VM_NAME" -- \
        sudo bash -p "$guest_root/scripts/flywheel-mac-install-guest.sh" "$guest_root"

    mkdir -p "$STATE_HOME" "$HOME/.local/bin"
    chmod 0700 "$STATE_HOME"
    printf '%s\n' "$root" >"$TEMP_ROOT/source-root"
    publish_private_file "$TEMP_ROOT/source-root" "$SOURCE_POINTER"
    write_install_receipt "$root" "$head" "$tree" "$guest_root" "$bundle_sha256"
    if [[ -e "$installed_cli" && "$source_cli" -ef "$installed_cli" ]]; then
        chmod 0755 "$installed_cli"
    else
        install -m 0755 "$source_cli" "$installed_cli"
    fi
    ok "Flywheel is installed on Ubuntu and available as flywheel"
}

start_command() {
    require_mac_tools
    acquire_lifecycle_lock "start"
    ensure_running
    ok "Flywheel is running"
}

status_command() {
    require_mac_tools
    local probe=""
    local status=""
    local root=""
    local head=""
    local tree=""
    local source_clean="false"
    local authority=""
    local repository_control=""
    local qualification_json=""
    local doctor_json=""
    local status_json=""
    probe="$(vm_probe)"
    status="$(probe_value "$probe" '["status"]')"
    root="$(find_source_root 2>/dev/null || true)"
    if [[ -n "$root" ]]; then
        head="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
        tree="$(git -C "$root" rev-parse 'HEAD^{tree}' 2>/dev/null || true)"
        authority="$root/config/flywheel-partial-safe-allowlist.json"
        repository_control="$root/scripts/flywheel-repository-control.py"
        if [[ -f "$root/config/flywheel-license-clearance.json" ]]; then
            authority="$root/config/flywheel-license-clearance.json"
        fi
        if git -C "$root" diff --quiet \
            && git -C "$root" diff --cached --quiet \
            && [[ -z "$(git -C "$root" ls-files --others --exclude-standard)" ]]; then
            source_clean="true"
        fi
    fi
    if [[ "$(probe_value "$probe" '["contract"]["matches"]')" == "true" \
        && "$status" == "Running" && -n "$root" && -n "$head" ]]; then
        set +e
        qualification_json="$(qualification_command "$head" 2>/dev/null)"
        doctor_json="$(doctor_command --json-internal 2>/dev/null)"
        set -e
    fi
    status_json="$(python3 - "$probe" "$root" "$head" "$tree" "$source_clean" "$INSTALL_RECEIPT" "$authority" "$repository_control" "$ROLLOUT_RECEIPT" "$qualification_json" "$doctor_json" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys

(
    vm_probe_raw,
    source_root,
    source_head,
    source_tree,
    source_clean_raw,
    install_receipt_path,
    authority_path,
    repository_control_path,
    rollout_receipt_path,
    qualification_raw,
    doctor_raw,
) = sys.argv[1:]

vm = json.loads(vm_probe_raw)
vm_status = vm["status"]
vm["healthy"] = bool(
    vm.get("query_status") == "ok"
    and vm.get("exists") is True
    and vm_status == "Running"
    and vm.get("contract", {}).get("matches") is True
)

def stable_read(path, maximum_bytes, label):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise ValueError(f"{label} must be a regular file")
        if before.st_size > maximum_bytes:
            raise ValueError(f"{label} exceeds {maximum_bytes} bytes")
        chunks = []
        remaining = before.st_size
        while remaining:
            block = os.read(descriptor, min(65536, remaining))
            if not block:
                raise ValueError(f"{label} ended while being read")
            chunks.append(block)
            remaining -= len(block)
        if os.read(descriptor, 1):
            raise ValueError(f"{label} grew while being read")
        after = os.fstat(descriptor)
        before_identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
        after_identity = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        if before_identity != after_identity:
            raise ValueError(f"{label} changed while being read")
        return b"".join(chunks)
    finally:
        os.close(descriptor)

def read_json(path, label):
    if not path:
        return None, None
    try:
        raw = stable_read(path, 4 * 1024 * 1024, label)
        return json.loads(raw), raw
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        return None, None

def is_hex(value, length):
    return isinstance(value, str) and len(value) == length and all(character in "0123456789abcdef" for character in value)

def parse_json(raw, schema):
    if raw:
        try:
            value = json.loads(raw)
            if isinstance(value, dict):
                return value
        except json.JSONDecodeError:
            pass
    return {"schema": schema, "status": "not_run"}

authority, authority_raw = read_json(authority_path, "commissioning authority")
authority = authority or {}
license_cleared = authority.get("schema") == "agent-flywheel.license-clearance/v1"
if license_cleared:
    commissioning = authority.get("commissioning", {})
    approved = commissioning.get("resolved_modules", [])
    independent_holds = commissioning.get("independent_holds", [])
    license_gate = authority.get("license_gate", {})
    expected_claim = "LICENSE_CLEARED_PARTIAL"
    expected_authority_kind = "license_clearance"
    licensing_cleared = license_gate.get("cleared_count", 0)
    licensing_pending = license_gate.get("pending_count", 0)
else:
    approved = authority.get("allowed_resolved_modules", [])
