repository_control_command() {
    local action="$1"
    local resource="$2"
    local root=""
    local script=""
    local arguments=("$action" "$resource")
    root="$(source_root)"
    script="$root/scripts/flywheel-repository-control.py"
    [[ -f "$script" && ! -L "$script" ]] \
        || die 3 "repository control is unavailable; rerun flywheel mac install from the current source"
    ((JSON == 1)) && arguments+=(--json)
    python3 "$script" "${arguments[@]}"
}

command_name="${1:-help}"
shift || true
subcommand=""
resource=""
if [[ "$command_name" == "mac" || "$command_name" == "robot-docs" \
    || "$command_name" == "repository" || "$command_name" == "rollout" ]]; then
    subcommand="${1:-}"
    shift || true
fi
if [[ "$command_name" == "repository" || "$command_name" == "rollout" ]]; then
    resource="${1:-}"
    [[ -n "$resource" ]] && shift || true
fi
while (($#)); do
    case "$1" in
        --json) JSON=1 ;;
        --rollout-receipt)
            (($# >= 2)) \
                || die 2 "--rollout-receipt requires a file; run flywheel status --json --rollout-receipt FILE"
            ROLLOUT_RECEIPT="$2"
            shift
            ;;
        --quiet) QUIET=1 ;;
        --no-gum) NO_GUM=1 ;;
        -h|--help) usage; exit 0 ;;
        --jsno|--jason) die 2 "unknown option: $1; did you mean: flywheel $command_name --json" ;;
        *) die 2 "unknown option: $1; run flywheel --help for the exact command" ;;
    esac
    shift
done

case "$command_name:$subcommand" in
    mac:install) install_command ;;
    start:) start_command ;;
    status:) status_command ;;
    doctor:) doctor_command ;;
    stop:) stop_command ;;
    capabilities:) capabilities_command ;;
    robot-docs:guide) robot_docs_command ;;
    repository:inspect)
        [[ -n "$resource" ]] \
            || die 2 "repository inspect requires a path; run flywheel repository inspect PATH --json"
        repository_control_command inspect "$resource"
        ;;
    rollout:plan)
        [[ -n "$resource" ]] \
            || die 2 "rollout plan requires an inventory; run flywheel rollout plan INVENTORY.json --json"
        repository_control_command plan "$resource"
        ;;
    help:|--help:|-h:) usage ;;
    mac:*) die 2 "unknown Mac action: ${subcommand:-missing}; run flywheel mac install" ;;
    robot-docs:*) die 2 "unknown robot-docs topic: ${subcommand:-missing}; run flywheel robot-docs guide" ;;
    repository:*) die 2 "unknown repository action: ${subcommand:-missing}; run flywheel repository inspect PATH --json" ;;
    rollout:*) die 2 "unknown rollout action: ${subcommand:-missing}; run flywheel rollout plan INVENTORY.json --json" ;;
    statsu:|stats:|state:) die 2 "unknown command: $command_name; did you mean: flywheel status --json" ;;
    docter:|doctro:) die 2 "unknown command: $command_name; did you mean: flywheel doctor --json" ;;
    instal:|install:) die 2 "unknown command: $command_name; did you mean: flywheel mac install" ;;
    *) die 2 "unknown command: $command_name; run flywheel --help for the exact command" ;;
esac
