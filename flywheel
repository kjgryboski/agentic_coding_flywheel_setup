    installation_json="$(installation_receipt_context)"
    installation_status="$(probe_value "$installation_json" '["status"]')"
    if [[ "$installation_status" == "receipt_missing" ]]; then
        die 1 "installation receipt is missing; run flywheel mac install"
    fi
    [[ "$installation_status" == "recorded" ]] \
        || die 2 "installation receipt is invalid; run flywheel mac install"
    guest_root="$(probe_value "$installation_json" '["source"]["guest_root"]')"
    expected_head="$(probe_value "$installation_json" '["source"]["head"]')"
    expected_tree="$(probe_value "$installation_json" '["source"]["tree"]')"
    authority_kind="$(probe_value "$installation_json" '["authority"]["kind"]')"
    authority_sha256="$(probe_value "$installation_json" '["authority"]["sha256"]')"
    if ((JSON == 1)) || [[ "$force_json" == "--json-internal" ]]; then
        json_flag="--json"
    fi
    doctor_for_installation \
        "$guest_root" "$expected_head" "$expected_tree" \
        "$authority_kind" "$authority_sha256" "$json_flag"
}

stop_command() {
    local probe=""
    require_mac_tools
    acquire_lifecycle_lock "stop"
    probe="$(vm_probe)"
    [[ "$(probe_value "$probe" '["query_status"]')" == "ok" ]] \
        || die 3 "cannot query Lima VM inventory; no VM was stopped"
    if [[ "$(probe_value "$probe" '["exists"]')" != "true" \
        || "$(probe_value "$probe" '["status"]')" != "Running" ]]; then
        ok "Flywheel is already stopped"
        return 0
    fi
    info "Stopping the Ubuntu Flywheel cleanly"
    "$LIMACTL" stop "$VM_NAME"
    ok "Flywheel is stopped"
}

