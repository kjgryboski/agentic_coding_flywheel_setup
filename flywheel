    }
    expected = authority_contracts.get(authority.get("kind"))
    if (
        expected is None
        or value.get("claim") != expected["claim"]
        or authority.get("guest_file") != expected["guest_file"]
        or authority.get("sha256") != expected["sha256"]
    ):
        raise ValueError("authority_binding")
    if not isinstance(value.get("installed_at"), str) or len(value["installed_at"]) > 64:
        raise ValueError("installed_at")

    approved_ids = modules.get("approved_ids")
    independent_holds = modules.get("independent_holds")
    module_pattern = re.compile(r"[a-z0-9][a-z0-9_.-]{0,127}\Z")
    if not isinstance(approved_ids, list) or not isinstance(independent_holds, list):
        raise ValueError("module_lists")
    if len(approved_ids) > 256 or len(independent_holds) > 64:
        raise ValueError("module_list_bound")
    if any(not isinstance(item, str) or module_pattern.fullmatch(item) is None for item in approved_ids + independent_holds):
        raise ValueError("module_identifier")
    if len(set(approved_ids)) != len(approved_ids) or len(set(independent_holds)) != len(independent_holds):
        raise ValueError("duplicate_module")
    for name in ("approved", "licensing_cleared", "licensing_pending"):
