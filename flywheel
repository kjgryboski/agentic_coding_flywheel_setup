#!/bin/bash
set -euo pipefail
shopt -s lastpipe 2>/dev/null || true
umask 022

# Host lifecycle decisions and publication must never resolve utilities from an
# inherited PATH. Third-party entrypoints are selected below by absolute path.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

SELF="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && pwd -P)/${BASH_SOURCE[0]##*/}"
STATE_HOME="${FLYWHEEL_STATE_HOME:-$HOME/.local/share/agent-flywheel}"
SOURCE_POINTER="$STATE_HOME/source-root"
INSTALL_RECEIPT="$STATE_HOME/installation.json"
VM_NAME="${FLYWHEEL_VM_NAME:-agent-flywheel-ubuntu2404}"
CANONICAL_VM_NAME="agent-flywheel-ubuntu2404"
VM_TEMPLATE_RELATIVE="config/flywheel-lima.yaml"
HEAVY_RUN="${FLYWHEEL_HEAVY_RUN:-$HOME/.local/bin/codex-heavy-run}"
if [[ -n "${FLYWHEEL_LIMACTL:-}" ]]; then
    LIMACTL="$FLYWHEEL_LIMACTL"
elif [[ -x "$HOME/.local/bin/limactl" ]]; then
    LIMACTL="$HOME/.local/bin/limactl"
elif [[ -x /opt/homebrew/bin/limactl ]]; then
    LIMACTL=/opt/homebrew/bin/limactl
elif [[ -x /usr/local/bin/limactl ]]; then
    LIMACTL=/usr/local/bin/limactl
else
    LIMACTL=""
fi
if [[ -x /opt/homebrew/bin/gum ]]; then
    GUM=/opt/homebrew/bin/gum
elif [[ -x /usr/local/bin/gum ]]; then
    GUM=/usr/local/bin/gum
else
    GUM=""
fi
ROLLOUT_RECEIPT="${FLYWHEEL_ROLLOUT_RECEIPT:-}"
PILOT_RECEIPT=""
PILOT_SOURCE=""
TARGET_REPOSITORY=""
QUIET=0
JSON=0
NO_GUM=0
TEMP_ROOT=""
LOCK_DIR=""
LOCK_HELPER_PID=""
LOCK_CONTROL_OPEN=0

cleanup() {
    if ((LOCK_CONTROL_OPEN == 1)); then
        exec 9>&- 2>/dev/null || true
        LOCK_CONTROL_OPEN=0
    fi
    if [[ -n "$LOCK_HELPER_PID" ]]; then
        wait "$LOCK_HELPER_PID" 2>/dev/null || true
        LOCK_HELPER_PID=""
    fi
    if [[ -n "$TEMP_ROOT" && -d "$TEMP_ROOT" ]]; then
        /bin/rm -rf -- "$TEMP_ROOT"
    fi
}

terminate_from_signal() {
    local signal_name="$1"
    local signal_status="$2"
    # SAFETY: EXIT is the only lock-cleanup boundary. A signal handler must
    # terminate T1 instead of closing the FIFO and returning while T1 can still
    # mutate; otherwise T2 can acquire the released kernel flock concurrently.
    trap - "$signal_name"
    exit "$signal_status"
}

trap cleanup EXIT
trap 'terminate_from_signal HUP 129' HUP
trap 'terminate_from_signal INT 130' INT
trap 'terminate_from_signal TERM 143' TERM

usage() {
    cat <<'USAGE'
Usage:
  flywheel mac install
  flywheel start
  flywheel status [--json] [--rollout-receipt FILE]
  flywheel doctor [--json]
  flywheel stop
  flywheel capabilities --json
  flywheel robot-docs guide
  flywheel repository inspect PATH [--json]
  flywheel repository eligibility PATH --pilot-receipt FILE --pilot-source PATH --target-repository OWNER/REPOSITORY [--json]
  flywheel rollout plan INVENTORY.json [--json]

Options:
  --json                  machine-readable read-side output
  --rollout-receipt FILE  attach one repository rollout evidence receipt
  --pilot-receipt FILE    sealed Ops synthetic-pilot receipt
  --pilot-source PATH     exact clean Ops source checkout bound by the pilot
  --target-repository ID  expected GitHub target as OWNER/REPOSITORY
  --quiet                 suppress non-error progress
  --no-gum                disable optional gum formatting
  -h, --help              show this help

Exit codes:
  0  command completed successfully
  1  status or doctor completed and found an unhealthy state
  2  invalid invocation or safety refusal
  3  required host environment is unavailable
  5  another operation owns the requested state

The Mac command manages the supported Ubuntu VM. Native macOS is not treated
as an ACFS installation. When the exact license-clearance receipt is present,
the command commissions the 26 newly eligible modules while preserving the
independent Agent Mail C5 and PFR qualification holds.
USAGE
}

info() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && [[ -n "$GUM" && -x "$GUM" && -t 1 ]]; then
        "$GUM" style --foreground 39 "→ $*"
    else
        printf '→ %s\n' "$*"
    fi
}

ok() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && [[ -n "$GUM" && -x "$GUM" && -t 1 ]]; then
        "$GUM" style --foreground 42 "✓ $*"
    else
        printf '✓ %s\n' "$*"
    fi
}

die() {
    local code="$1"
    shift
    printf 'Flywheel: %s\n' "$*" >&2
    exit "$code"
}

safe_git() {
    /usr/bin/env -i \
        HOME="$HOME" \
        PATH=/usr/bin:/bin:/usr/sbin:/sbin \
        TMPDIR="${TMPDIR:-/tmp}" \
        LANG=C \
        LC_ALL=C \
        GIT_ATTR_NOSYSTEM=1 \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_SYSTEM=/dev/null \
        GIT_EXTERNAL_DIFF= \
        GIT_LITERAL_PATHSPECS=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git \
        -c core.fsmonitor=false \
        -c core.untrackedCache=false \
        -c core.hooksPath=/dev/null \
        -c diff.external= \
        -c interactive.diffFilter= \
        "$@"
}

tracked_regular_files_match_head() {
    local root="$1"
    local head="$2"
    local entry=""
    local metadata=""
    local mode=""
    local object_type=""
    local object_id=""
    local relative_path=""
    local regular_count=0
    [[ "$head" =~ ^[0-9a-f]{40}$ ]] || return 1
    while IFS= read -r -d '' entry; do
        [[ "$entry" == *$'\t'* ]] || return 1
        metadata="${entry%%$'\t'*}"
        relative_path="${entry#*$'\t'}"
        read -r mode object_type object_id <<<"$metadata"
        [[ "$relative_path" != /* \
            && "$relative_path" != ".." \
            && "$relative_path" != ../* \
            && "$relative_path" != */../* \
            && "$relative_path" != */.. ]] || return 1
        case "$mode" in
            100644|100755)
                [[ "$object_type" == "blob" && "$object_id" =~ ^[0-9a-f]{40}$ \
                    && -f "$root/$relative_path" && ! -L "$root/$relative_path" ]] \
                    || return 1
                safe_git -C "$root" cat-file blob "$object_id" \
                    | /usr/bin/cmp -s - "$root/$relative_path" \
                    || return 1
                regular_count=$((regular_count + 1))
                ;;
        esac
    done < <(safe_git -C "$root" ls-tree -r -z --full-tree "$head")
    ((regular_count > 0))
}

git_index_flags_safe() {
    local root="$1"
    safe_git -C "$root" ls-files -v -z --cached \
        | /usr/bin/python3 -I -c '
import sys
records = [item for item in sys.stdin.buffer.read().split(b"\0") if item]
raise SystemExit(0 if all(len(item) >= 3 and item[0:1] == b"H" and item[1:2] == b" " for item in records) else 1)
'
}

ensure_temp_root() {
    if [[ -z "$TEMP_ROOT" ]]; then
        TEMP_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/flywheel.XXXXXXXX")"
        /bin/chmod 0700 "$TEMP_ROOT"
    fi
}

read_source_pointer() {
    /usr/bin/python3 -I - "$SOURCE_POINTER" <<'PY'
import os
import stat
import sys

path = sys.argv[1]
flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
if not hasattr(os, "O_NOFOLLOW"):
    raise SystemExit(1)
flags |= os.O_NOFOLLOW
try:
    descriptor = os.open(path, flags)
except OSError:
    raise SystemExit(1)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_size > 4096:
        raise SystemExit(1)
    raw = os.read(descriptor, 4097)
    if len(raw) != metadata.st_size or len(raw) > 4096 or os.read(descriptor, 1):
        raise SystemExit(1)
finally:
    os.close(descriptor)
try:
    value = raw.decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(1)
lines = value.splitlines()
if len(lines) != 1 or not lines[0].startswith("/") or "\x00" in lines[0]:
    raise SystemExit(1)
print(lines[0])
PY
}

find_source_root() {
    local self_dir="${SELF%/*}"
    local candidate="${FLYWHEEL_SOURCE_REPO:-}"
    if [[ -z "$candidate" && -f "$self_dir/acfs.manifest.yaml" ]]; then
        candidate="$self_dir"
    fi
    if [[ -z "$candidate" ]]; then
        candidate="$(read_source_pointer 2>/dev/null || true)"
    fi
    [[ -n "$candidate" && "$candidate" == /* && -f "$candidate/acfs.manifest.yaml" ]] \
        || return 1
    (cd "$candidate" && pwd -P)
}

source_root() {
    find_source_root \
        || die 3 "cannot locate the ACFS source checkout; set FLYWHEEL_SOURCE_REPO"
}

require_mac_tools() {
    [[ "$(/usr/bin/uname -s)" == "Darwin" ]] \
        || die 3 "Mac lifecycle commands require macOS"
    [[ -n "$LIMACTL" && "$LIMACTL" == /* && -x "$LIMACTL" && ! -d "$LIMACTL" ]] \
        || die 3 "Lima is required; install it, then retry the same command"
}

vm_probe() {
    local inventory=""
    if ! inventory="$("$LIMACTL" list --json 2>/dev/null)"; then
        /usr/bin/python3 -I - "$VM_NAME" "$CANONICAL_VM_NAME" <<'PY'
import json
import sys

print(json.dumps({
    "query_status": "error",
    "exists": None,
    "name": sys.argv[1],
    "status": "Unavailable",
    "resources": None,
    "contract": {
        "id": "agent-flywheel.mac-vm/v1",
        "matches": False,
        "expected_name": sys.argv[2],
    },
    "mismatches": ["inventory_query_failed"],
}, sort_keys=True, separators=(",", ":")))
PY
        return 0
    fi
    /usr/bin/python3 -I - "$VM_NAME" "$CANONICAL_VM_NAME" "$inventory" <<'PY'
import json
import sys

selected_name, expected_name, raw = sys.argv[1:]
expected = {
    "name": expected_name,
    "vm_type": "vz",
    "architecture": "aarch64",
    "cpus": 6,
    "memory_bytes": 10 * 1024 ** 3,
    "disk_bytes": 68 * 1024 ** 3,
    "image": {
        "location": "https://cloud-images.ubuntu.com/releases/24.04/release-20260814/ubuntu-24.04-server-cloudimg-arm64.img",
        "digest": "sha256:4a281a921b8d7db952895ab619736f10efe9f63e111fa5b5779ed18f023818aa",
    },
    "plain": True,
    "mount_count": 0,
    "exposed_guest_ports": False,
}
try:
    items = [json.loads(line) for line in raw.splitlines() if line.strip()]
    if any(not isinstance(item, dict) for item in items):
        raise ValueError("inventory item is not an object")
except (json.JSONDecodeError, ValueError):
    print(json.dumps({
        "query_status": "error",
        "exists": None,
        "name": selected_name,
        "status": "Unavailable",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": ["inventory_response_invalid"],
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

matches = [item for item in items if item.get("name") == selected_name]
if len(matches) > 1:
    print(json.dumps({
        "query_status": "error",
        "exists": None,
        "name": selected_name,
        "status": "Unavailable",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": ["inventory_name_duplicated"],
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

if not matches:
    mismatches = ["vm_missing"]
    if selected_name != expected_name:
        mismatches.insert(0, "name")
    print(json.dumps({
        "query_status": "ok",
        "exists": False,
        "name": selected_name,
        "status": "Missing",
        "resources": None,
        "contract": {
            "id": "agent-flywheel.mac-vm/v1",
            "matches": False,
            "expected": expected,
        },
        "mismatches": mismatches,
    }, sort_keys=True, separators=(",", ":")))
    raise SystemExit(0)

item = matches[0]
config = item.get("config") if isinstance(item.get("config"), dict) else {}
images = config.get("images") if isinstance(config.get("images"), list) else []
image = images[0] if len(images) == 1 and isinstance(images[0], dict) else {}
mounts = config.get("mounts", [])
mount_count = len(mounts) if isinstance(mounts, list) else None
port_forwards = config.get("portForwards", [])
if isinstance(port_forwards, list):
    exposed_guest_ports = any(
        not isinstance(rule, dict) or rule.get("ignore") is not True
        for rule in port_forwards
    )
else:
    exposed_guest_ports = True
resources = {
    "vm_type": item.get("vmType"),
    "architecture": item.get("arch"),
    "cpus": item.get("cpus"),
    "memory_bytes": item.get("memory"),
    "disk_bytes": item.get("disk"),
    "image": {
        "location": image.get("location"),
        "digest": image.get("digest"),
    },
    "plain": config.get("plain"),
    "mount_count": mount_count,
    "exposed_guest_ports": exposed_guest_ports,
}
mismatches = []
if selected_name != expected_name:
    mismatches.append("name")
for field in ("vm_type", "architecture", "cpus", "memory_bytes", "disk_bytes", "plain", "mount_count", "exposed_guest_ports"):
    if resources[field] != expected[field]:
        mismatches.append(field)
if resources["image"] != expected["image"]:
    mismatches.append("image")
print(json.dumps({
    "query_status": "ok",
    "exists": True,
    "name": selected_name,
    "status": item.get("status", "Unknown"),
    "resources": resources,
    "contract": {
        "id": "agent-flywheel.mac-vm/v1",
        "matches": not mismatches,
        "expected": expected,
    },
    "mismatches": mismatches,
}, sort_keys=True, separators=(",", ":")))
PY
}

probe_value() {
    /usr/bin/python3 -I -c 'import json,sys; value=json.loads(sys.argv[1]); result=value'"$2"'; print(json.dumps(result) if isinstance(result, (dict, list, bool)) or result is None else result)' "$1"
}

ensure_running() {
    local probe=""
    local query_status=""
    local exists=""
    local status=""
    local contract_matches=""
    local mismatches=""
    local root=""
    local template=""
    local template_head=""
    [[ "$VM_NAME" == "$CANONICAL_VM_NAME" ]] \
        || die 2 "unsupported VM name $VM_NAME; the Mac lifecycle contract requires $CANONICAL_VM_NAME"
    probe="$(vm_probe)"
    query_status="$(probe_value "$probe" '["query_status"]')"
    [[ "$query_status" == "ok" ]] \
        || die 3 "cannot query Lima VM inventory; no VM was created or changed"
    exists="$(probe_value "$probe" '["exists"]')"
    status="$(probe_value "$probe" '["status"]')"
    contract_matches="$(probe_value "$probe" '["contract"]["matches"]')"
    mismatches="$(probe_value "$probe" '["mismatches"]')"
    if [[ "$exists" == "false" ]]; then
        [[ -x "$HEAVY_RUN" ]] \
            || die 3 "the Mac heavy-work safety guard is unavailable; restore $HEAVY_RUN, then run flywheel start"
        root="$(source_root)"
        template="$root/$VM_TEMPLATE_RELATIVE"
        [[ -f "$template" && ! -L "$template" ]] \
            || die 3 "the canonical Lima template is unavailable or unsafe: $template"
        safe_git -C "$root" ls-files --error-unmatch -- "$VM_TEMPLATE_RELATIVE" >/dev/null 2>&1 \
            || die 2 "the canonical Lima template is not tracked by the exact source checkout; no VM was created"
        git_index_flags_safe "$root" \
            || die 2 "the source checkout has unsafe index flags; no VM was created"
        template_head="$(safe_git -C "$root" rev-parse --verify HEAD)"
        safe_git -C "$root" show "$template_head:$VM_TEMPLATE_RELATIVE" \
            | /usr/bin/cmp -s - "$template" \
            || die 2 "the canonical Lima template bytes differ from the committed source; no VM was created"
        safe_git -C "$root" diff --cached --quiet --no-ext-diff --no-textconv -- "$VM_TEMPLATE_RELATIVE" \
            || die 2 "the canonical Lima template has staged drift; no VM was created"
        "$LIMACTL" validate "$template" >/dev/null \
            || die 2 "the canonical Lima template failed validation; no VM was created"
        info "Creating the isolated Ubuntu Flywheel"
        "$HEAVY_RUN" --stateful -- "$LIMACTL" start --tty=false --name="$VM_NAME" "$template" \
            || die 3 "Lima could not create and start $VM_NAME"
    else
        [[ "$contract_matches" == "true" ]] \
            || die 2 "existing VM $VM_NAME does not match the Flywheel contract ($mismatches); it was not changed"
        if [[ "$status" == "Running" ]]; then
            return 0
        fi
        [[ "$status" == "Stopped" ]] \
            || die 2 "existing VM $VM_NAME is $status; it was not changed"
        [[ -x "$HEAVY_RUN" ]] \
            || die 3 "the Mac heavy-work safety guard is unavailable; restore $HEAVY_RUN, then run flywheel start"
        info "Starting the Ubuntu Flywheel"
        "$HEAVY_RUN" --stateful -- "$LIMACTL" start --tty=false "$VM_NAME" \
            || die 3 "Lima could not start $VM_NAME"
    fi
    probe="$(vm_probe)"
    query_status="$(probe_value "$probe" '["query_status"]')"
    exists="$(probe_value "$probe" '["exists"]')"
    status="$(probe_value "$probe" '["status"]')"
    contract_matches="$(probe_value "$probe" '["contract"]["matches"]')"
    mismatches="$(probe_value "$probe" '["mismatches"]')"
    [[ "$query_status" == "ok" ]] \
        || die 3 "Lima started work but the VM inventory re-query failed; inspect $VM_NAME before retrying"
    [[ "$exists" == "true" ]] \
        || die 3 "Lima reported success but $VM_NAME is still absent"
    [[ "$contract_matches" == "true" ]] \
        || die 2 "created or started VM $VM_NAME does not match the Flywheel contract ($mismatches); it was left unchanged for inspection"
    [[ "$status" == "Running" ]] \
        || die 3 "Lima reported success but $VM_NAME is $status"
}

acquire_lifecycle_lock() {
    local operation="$1"
    local lock_root="$STATE_HOME/locks"
    local control_fifo=""
    local result_file=""
    local helper_program=""
    local result=""
    local attempts=0

    if [[ -e "$STATE_HOME" || -L "$STATE_HOME" ]]; then
        [[ -d "$STATE_HOME" && ! -L "$STATE_HOME" ]] \
            || die 3 "lifecycle state directory is unavailable or unsafe"
    else
        /bin/mkdir -p "$STATE_HOME"
    fi
    if [[ -e "$lock_root" || -L "$lock_root" ]]; then
        [[ -d "$lock_root" && ! -L "$lock_root" ]] \
            || die 3 "lifecycle lock directory is unavailable or unsafe"
    else
        /bin/mkdir "$lock_root"
    fi
    /bin/chmod 0700 "$STATE_HOME" "$lock_root"
    LOCK_DIR="$lock_root/lifecycle.lock"
    if ! /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
        [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] \
            || die 3 "lifecycle lock container is unavailable or unsafe"
    fi
    /bin/chmod 0700 "$LOCK_DIR"

    ensure_temp_root
    control_fifo="$TEMP_ROOT/lifecycle-control"
    result_file="$TEMP_ROOT/lifecycle-lock-result"
    helper_program="$TEMP_ROOT/lifecycle-lock-helper.py"
    /usr/bin/mkfifo -m 0600 "$control_fifo"
    /bin/cat >"$helper_program" <<'PY'
import datetime
import errno
import fcntl
import json
import os
import stat
import sys

lock_path, result_path, operation, owner_pid = sys.argv[1:]

def publish(value):
    candidate = result_path + ".candidate"
    descriptor = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(descriptor, (value + "\n").encode("utf-8"))
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(candidate, result_path)

descriptor = None
try:
    if not hasattr(os, "O_NOFOLLOW"):
        raise RuntimeError("O_NOFOLLOW is unavailable")
    flags = os.O_RDWR | os.O_CREAT | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(lock_path, flags, 0o600)
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_nlink != 1
        or metadata.st_mode & 0o077
    ):
        raise RuntimeError("lock owner file is not a private regular file")
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EAGAIN):
            publish("CONFLICT")
            raise SystemExit(0)
        raise
    owner = {
        "acquired_at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat(),
        "helper_pid": os.getpid(),
        "operation": operation,
        "owner_pid": int(owner_pid),
        "schema": "agent-flywheel.lifecycle-lock/v1",
    }
    encoded = (json.dumps(owner, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    if len(encoded) > 4096:
        raise RuntimeError("lock metadata exceeds its bound")
    os.ftruncate(descriptor, 0)
    os.write(descriptor, encoded)
    os.fsync(descriptor)
    publish("ACQUIRED")
    while sys.stdin.buffer.read(65536):
        pass
except SystemExit:
    raise
except Exception as error:
    try:
        publish("ERROR:" + type(error).__name__)
    except Exception:
        pass
    raise SystemExit(1)
finally:
    if descriptor is not None:
        os.close(descriptor)
PY
    /bin/chmod 0600 "$helper_program"
    /usr/bin/python3 -I "$helper_program" "$LOCK_DIR/owner.lock" "$result_file" "$operation" "$$" \
        <"$control_fifo" &
    LOCK_HELPER_PID=$!
    exec 9>"$control_fifo"
    LOCK_CONTROL_OPEN=1

    while [[ ! -s "$result_file" ]] && kill -0 "$LOCK_HELPER_PID" 2>/dev/null; do
        attempts=$((attempts + 1))
        if ((attempts >= 100)); then
            break
        fi
        /bin/sleep 0.05
    done
    if [[ -s "$result_file" ]]; then
        IFS= read -r result <"$result_file"
    fi
    if [[ "$result" == "ACQUIRED" ]]; then
        return 0
    fi

    exec 9>&- 2>/dev/null || true
    LOCK_CONTROL_OPEN=0
    wait "$LOCK_HELPER_PID" 2>/dev/null || true
    LOCK_HELPER_PID=""
    if [[ "$result" == "CONFLICT" ]]; then
        die 5 "another Flywheel lifecycle operation is running; retry flywheel $operation after it finishes"
    fi
    die 3 "the lifecycle lock could not be acquired safely"
}

sha256_file() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

publish_private_file() {
    local source="$1"
    local destination="$2"
    local parent="${destination%/*}"
    local name="${destination##*/}"
    local candidate=""
    [[ -d "$parent" && ! -L "$parent" ]] \
        || die 3 "state directory is unavailable or unsafe: $parent"
    candidate="$(/usr/bin/mktemp "$parent/.$name.XXXXXXXX")"
    /usr/bin/install -m 0600 "$source" "$candidate"
    /bin/mv -f "$candidate" "$destination"
}

verify_guest_source() {
    local guest_root="$1"
    local expected_head="$2"
    local expected_tree="$3"
    local verification_status=0
    [[ "$guest_root" =~ ^/opt/agent-flywheel-acfs-[0-9a-f]{40}$ \
        && "$expected_head" =~ ^[0-9a-f]{40}$ \
        && "$expected_tree" =~ ^[0-9a-f]{40}$ \
        && "$guest_root" == "/opt/agent-flywheel-acfs-$expected_head" ]] \
        || die 2 "installation receipt contains invalid exact-source bindings"
    "$LIMACTL" shell "$VM_NAME" -- sudo /bin/bash -s -- \
        flywheel-verify-exact-guest-source \
        "$guest_root" "$expected_head" "$expected_tree" <<'SH' \
        || verification_status=$?
set -euo pipefail
[[ "${1:-}" == "flywheel-verify-exact-guest-source" ]]
shift
guest_root="$1"
expected_head="$2"
expected_tree="$3"

guest_git() {
    /usr/bin/env -i \
        HOME=/root \
        PATH=/usr/bin:/bin \
        LANG=C \
        LC_ALL=C \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_SYSTEM=/dev/null \
        GIT_ATTR_NOSYSTEM=1 \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_EXTERNAL_DIFF= \
        GIT_LITERAL_PATHSPECS=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git \
            -c "safe.directory=$guest_root" \
            -c core.fsmonitor=false \
            -c core.untrackedCache=false \
            -c core.hooksPath=/dev/null \
            -c diff.external= \
            -c interactive.diffFilter= \
            -C "$guest_root" "$@"
}

[[ -d "$guest_root" && ! -L "$guest_root" \
    && -d "$guest_root/.git" && ! -L "$guest_root/.git" ]]
[[ "$(cd "$guest_root" && pwd -P)" == "$guest_root" ]]
[[ "$(guest_git rev-parse --verify HEAD)" == "$expected_head" ]]
[[ "$(guest_git rev-parse 'HEAD^{tree}')" == "$expected_tree" ]]

# Every cached path must have the normal H tag. Lowercase assume-unchanged,
# S skip-worktree/sparse, and unmerged stage tags are all fail-closed.
guest_git ls-files -v -z --cached | (
    count=0
    while IFS= read -r -d '' record; do
        count=$((count + 1))
        [[ "${record:0:2}" == "H " ]]
    done
    ((count > 0))
)
guest_git diff --cached --quiet --no-ext-diff --no-textconv
[[ -z "$(guest_git ls-files --others --exclude-standard)" ]]

# Compare every tracked regular file to its raw committed blob. Git worktree
# diff is deliberately not part of this trust boundary: repository-local
# clean/process filters can execute code and normalize malicious worktree bytes.
regular_count=0
while IFS= read -r -d '' entry; do
    [[ "$entry" == *$'\t'* ]]
    metadata="${entry%%$'\t'*}"
    tracked_path="${entry#*$'\t'}"
    read -r mode object_type object_id <<<"$metadata"
    [[ "$tracked_path" != /* \
        && "$tracked_path" != ".." \
        && "$tracked_path" != ../* \
        && "$tracked_path" != */../* \
        && "$tracked_path" != */.. ]]
    case "$mode" in
        100644|100755)
            [[ "$object_type" == "blob" && "$object_id" =~ ^[0-9a-f]{40}$ \
                && -f "$guest_root/$tracked_path" && ! -L "$guest_root/$tracked_path" ]]
            guest_git cat-file blob "$object_id" \
                | /usr/bin/cmp -s - "$guest_root/$tracked_path"
            regular_count=$((regular_count + 1))
            ;;
    esac
done < <(guest_git ls-tree -r -z --full-tree "$expected_head")
((regular_count > 0))
for required_path in \
    scripts/flywheel-mac-install-guest.sh \
    scripts/flywheel-ensure-swap.sh \
    scripts/flywheel-qualification-host.sh \
    scripts/flywheel-partial-safe-doctor.sh \
    scripts/lib/contract.sh \
    install.sh; do
    [[ -f "$guest_root/$required_path" && ! -L "$guest_root/$required_path" ]]
done
[[ "$(guest_git rev-parse --verify HEAD)" == "$expected_head" ]]
[[ "$(guest_git rev-parse 'HEAD^{tree}')" == "$expected_tree" ]]
SH
    if ((verification_status != 0)); then
        printf 'Flywheel: exact guest source verification failed; rerun flywheel mac install from a clean exact source\n' >&2
        return "$verification_status"
    fi
}

stage_source() {
    local root="$1"
    local head="$2"
    local tree="$3"
    local short="${head:0:12}"
    local bundle="$TEMP_ROOT/acfs-$short.bundle"
    local bundle_sha256=""
    local guest_bundle="/var/tmp/agent-flywheel-acfs-$head.bundle"
    local guest_root="/opt/agent-flywheel-acfs-$head"

    safe_git -C "$root" bundle create "$bundle" HEAD
    bundle_sha256="$(sha256_file "$bundle")"
    "$LIMACTL" copy --backend=scp "$bundle" "$VM_NAME:$guest_bundle" >/dev/null
    "$LIMACTL" shell "$VM_NAME" -- /bin/bash -lc '
set -euo pipefail
guest_bundle="$1"
guest_root="$2"
if [[ ! -d "$guest_root/.git" ]]; then
    sudo /usr/bin/env -i \
        HOME=/root \
