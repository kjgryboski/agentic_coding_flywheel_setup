def validate_qualification(raw):
    if not raw:
        return {"schema": qualification_schema, "status": "not_run"}
    try:
        value = load_receipt(raw, qualification_schema)
        if set(value) != {
            "bundle", "contract", "host", "observed_at", "receipt_sha256",
            "requirements", "schema", "source", "status", "summary",
        }:
            raise ValueError("qualification receipt fields are invalid")
        verify_receipt_digest(value)
        expected_contract = {
            "host_identity": "any-compliant-host",
            "ubuntu_version": "24.04",
            "architectures": ["aarch64", "x86_64"],
            "minimum_disk_gib": 20,
            "minimum_memory_gib": 8,
            "minimum_swap_gib": 8,
            "minimum_bash_major": 4,
            "isolation_required": True,
            "clean_source_identity_required": True,
            "critical_source_bytes_required": ["all-tracked-regular-files"],
            "exact_bundle_identity_required": True,
            "receipt_digest": "sha256(canonical-json-without-receipt_sha256+newline)",
        }
        if value.get("contract") != expected_contract:
            raise ValueError("qualification contract is not exact")
        if not isinstance(value.get("observed_at"), str) or len(value["observed_at"]) > 64:
            raise ValueError("qualification observation time is invalid")
        source = value.get("source")
        if not isinstance(source, dict) or set(source) != {
            "clean", "clean_state_evidence", "git_paths", "head", "requested_root", "tree",
        }:
            raise ValueError("qualification source fields are invalid")
        if source.get("head") != recorded_source.get("head") or source.get("tree") != recorded_source.get("tree"):
            raise ValueError("qualification source identity is not the installed source")
        if source.get("requested_root") != recorded_source.get("guest_root"):
            raise ValueError("qualification source root is not the installed source")
        git_paths = source.get("git_paths")
        if not isinstance(git_paths, dict) or set(git_paths) != {"common_dir", "git_dir", "index", "root"}:
            raise ValueError("qualification Git paths are invalid")
        if git_paths.get("root") != recorded_source.get("guest_root") or any(
            not isinstance(item, str) or not item.startswith("/") for item in git_paths.values()
        ):
            raise ValueError("qualification Git paths are not absolute and bound")
        evidence = source.get("clean_state_evidence")
        expected_evidence_keys = {
            "critical_source_bytes_match", "git_repository", "index_clean",
            "index_flags_clean", "repository_binding_stable", "sparse_checkout_disabled",
            "unmerged_index_clean", "untracked_clean", "worktree_clean",
        }
        if not isinstance(evidence, dict) or set(evidence) != expected_evidence_keys:
            raise ValueError("qualification clean-state evidence is invalid")
        bundle = value.get("bundle")
        expected_bundle_sha256 = installation.get("bundle", {}).get("sha256")
        if not isinstance(bundle, dict) or set(bundle) != {"sha256", "source_head", "verified"}:
            raise ValueError("qualification bundle fields are invalid")
        if (
            bundle.get("sha256") != expected_bundle_sha256
            or bundle.get("source_head") != recorded_source.get("head")
            or bundle.get("verified") is not True
        ):
            raise ValueError("qualification bundle is not the installed bundle")
        host = value.get("host")
        if not isinstance(host, dict) or set(host) != {
            "architecture", "bash_version", "isolation", "os", "resources",
        }:
            raise ValueError("qualification host fields are invalid")
        if host.get("os") != {"id": "ubuntu", "version": "24.04"}:
            raise ValueError("qualification operating system is invalid")
        if host.get("architecture") not in {"aarch64", "x86_64"}:
            raise ValueError("qualification architecture is invalid")
        if not isinstance(host.get("bash_version"), str) or not host["bash_version"]:
            raise ValueError("qualification Bash version is invalid")
        if not isinstance(host.get("isolation"), str) or host["isolation"] in {"", "none"}:
            raise ValueError("qualification isolation is invalid")
        resources = host.get("resources")
        if not isinstance(resources, dict) or set(resources) != {
            "disk_free_bytes", "memory_total_bytes", "swap_total_bytes",
        } or any(isinstance(item, bool) or not isinstance(item, int) or item < 0 for item in resources.values()):
            raise ValueError("qualification resources are invalid")
        requirements = value.get("requirements")
        expected_requirement_ids = [
            "ubuntu_version", "architecture", "bash_runtime", "disk_free", "memory_total",
            "swap_total", "isolation", "source_identity", "bundle_identity",
        ]
        if not isinstance(requirements, list) or [item.get("id") for item in requirements if isinstance(item, dict)] != expected_requirement_ids:
            raise ValueError("qualification requirements are invalid")
        if any(
            set(item) != {"detail", "id", "status"}
            or item.get("status") not in {"pass", "fail"}
            or not isinstance(item.get("detail"), str)
            for item in requirements
        ):
            raise ValueError("qualification requirement rows are invalid")
        failures = sum(item["status"] != "pass" for item in requirements)
        expected_status = "pass" if failures == 0 else "fail"
        if value.get("status") != expected_status or value.get("summary") != {
            "pass": len(requirements) - failures, "fail": failures,
        }:
            raise ValueError("qualification summary is inconsistent")
        if value["status"] == "pass" and (
            source.get("clean") is not True or any(item is not True for item in evidence.values())
        ):
            raise ValueError("passing qualification has incomplete clean-state evidence")
        return value
    except (AttributeError, TypeError, ValueError) as error:
        return invalid_receipt(qualification_schema, str(error))

def validate_doctor(raw):
    if not raw:
        return {"schema": doctor_schema, "status": "not_run"}
    try:
        value = load_receipt(raw, doctor_schema)
        if set(value) != {
            "authority", "checks", "claim", "fully_commissioned", "receipt_sha256",
            "schema", "source", "status", "summary",
        }:
            raise ValueError("doctor receipt fields are invalid")
        verify_receipt_digest(value)
        if value.get("claim") != expected_claim or value.get("fully_commissioned") is not False:
            raise ValueError("doctor claim is not the installed claim")
        if value.get("source") != {
            "head": recorded_source.get("head"), "tree": recorded_source.get("tree"),
        }:
            raise ValueError("doctor source is not the installed source")
        if value.get("authority") != {
            "kind": receipt_authority.get("kind"), "sha256": receipt_authority.get("sha256"),
        }:
            raise ValueError("doctor authority is not the installed authority")
        expected_check_ids = [
            "license_clearance" if license_cleared else "allowlist",
            "target_identity", "base.system", "users.ubuntu", "host.swap_contract",
            "base.filesystem", "cli.modern", "lang.bun/bun", "lang.uv/uv",
            "lang.rust/rustc", "lang.rust/cargo", "lang.go/go",
