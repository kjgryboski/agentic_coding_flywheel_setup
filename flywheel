            "pass": len(checks) - failures, "warn": 0, "fail": failures,
        }:
            raise ValueError("doctor summary is inconsistent")
        return value
    except (AttributeError, TypeError, ValueError) as error:
        return invalid_receipt(doctor_schema, str(error))

