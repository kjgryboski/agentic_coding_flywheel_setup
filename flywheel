installation_receipt_context() {
    /usr/bin/python3 -I - "$INSTALL_RECEIPT" <<'PY'
import hashlib
import hmac
import json
import os
import re
import stat
import sys

path = sys.argv[1]
maximum_bytes = 64 * 1024

def result(status, error=None):
    value = {"schema": "agent-flywheel.installation/v1", "status": status}
    if error:
        value["error"] = error
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))

if not hasattr(os, "O_NOFOLLOW"):
    result("receipt_invalid", "nofollow_unavailable")
    raise SystemExit(0)
flags = os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
try:
    descriptor = os.open(path, flags)
except FileNotFoundError:
    result("receipt_missing")
    raise SystemExit(0)
except OSError:
    result("receipt_invalid", "unsafe_or_unreadable")
    raise SystemExit(0)

try:
    before = os.fstat(descriptor)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.getuid()
        or before.st_nlink != 1
        or before.st_size > maximum_bytes
    ):
        raise ValueError("unsafe_metadata")
    raw = os.read(descriptor, maximum_bytes + 1)
    if len(raw) != before.st_size or len(raw) > maximum_bytes or os.read(descriptor, 1):
        raise ValueError("unstable_size")
    after = os.fstat(descriptor)
    if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
        after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns
    ):
        raise ValueError("changed_during_read")
except (OSError, ValueError):
    result("receipt_invalid", "unsafe_or_unstable")
    raise SystemExit(0)
finally:
    os.close(descriptor)

try:
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("root_not_object")
    if set(value) != {
        "authority", "bundle", "claim", "installed_at", "modules",
        "receipt_sha256", "schema", "source",
    }:
        raise ValueError("unexpected_fields")
    receipt_digest = value.get("receipt_sha256")
    digest_source = dict(value)
    digest_source.pop("receipt_sha256", None)
    canonical = (
        json.dumps(digest_source, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n"
    ).encode()
    observed_digest = hashlib.sha256(canonical).hexdigest()
    if not isinstance(receipt_digest, str) or not hmac.compare_digest(receipt_digest, observed_digest):
        raise ValueError("digest_mismatch")

    source = value.get("source")
    bundle = value.get("bundle")
    authority = value.get("authority")
    modules = value.get("modules")
    if not all(isinstance(item, dict) for item in (source, bundle, authority, modules)):
        raise ValueError("section_not_object")
    if set(source) != {"guest_root", "head", "tree"} or set(bundle) != {"sha256"}:
        raise ValueError("source_or_bundle_fields")
    if set(authority) != {"guest_file", "kind", "sha256"}:
        raise ValueError("authority_fields")
    if set(modules) != {
        "approved", "approved_ids", "independent_holds", "licensing_cleared", "licensing_pending"
    }:
        raise ValueError("module_fields")

    is_hex = lambda item, size: isinstance(item, str) and re.fullmatch(f"[0-9a-f]{{{size}}}", item) is not None
    if not is_hex(source.get("head"), 40) or not is_hex(source.get("tree"), 40):
        raise ValueError("source_identity")
    if source.get("guest_root") != "/opt/agent-flywheel-acfs-" + source["head"]:
        raise ValueError("guest_root_binding")
    if not is_hex(bundle.get("sha256"), 64) or not is_hex(authority.get("sha256"), 64):
        raise ValueError("digest_format")

    authority_contracts = {
        "partial_safe_allowlist": {
            "claim": "PARTIAL_SAFE",
            "guest_file": "/var/lib/agent-flywheel/doctor-allowlist.json",
            "sha256": "736ce053c42c91b4219cc13dde7a604c33158e1369f3d4d91031672da80f3633",
            "modules": {
                "approved": 8,
                "approved_ids": [
                    "base.system", "users.ubuntu", "base.filesystem", "cli.modern",
                    "lang.bun", "lang.uv", "lang.rust", "lang.go",
                ],
                "independent_holds": [],
                "licensing_cleared": 0,
                "licensing_pending": 27,
            },
        },
        "license_clearance": {
            "claim": "LICENSE_CLEARED_PARTIAL",
            "guest_file": "/var/lib/agent-flywheel/doctor-license-clearance.json",
            "sha256": "90b9e45ea3e5f2db4b409d38b539df2aef80b3a6a4faf69ec699d0cfa5515c68",
            "modules": {
                "approved": 36,
                "approved_ids": [
                    "base.system", "users.ubuntu", "base.filesystem", "cli.modern",
                    "lang.bun", "lang.uv", "lang.rust", "lang.go", "tools.ast_grep",
                    "agents.claude", "stack.ntm", "stack.meta_skill",
                    "stack.automated_plan_reviser", "stack.jeffreysprompts",
                    "stack.process_triage", "stack.ultimate_bug_scanner",
                    "stack.beads_rust", "stack.beads_viewer", "stack.cass", "stack.cm",
                    "stack.caam", "stack.slb", "stack.dcg", "stack.ru",
                    "stack.brenner_bot", "stack.rch", "stack.srps",
                    "stack.frankensearch", "stack.storage_ballast_helper",
                    "stack.cross_agent_session_resumer", "stack.doodlestein_self_releaser",
                    "stack.agent_settings_backup", "stack.pcr", "stack.eidetic_engine_cli",
                    "stack.franken_markdown", "stack.pi_agent_rust",
                ],
                "independent_holds": ["stack.mcp_agent_mail", "stack.power_failure_resumer"],
                "licensing_cleared": 27,
                "licensing_pending": 0,
            },
