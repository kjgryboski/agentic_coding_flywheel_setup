        expected_check_ids.append("state")
        checks = value.get("checks")
        if not isinstance(checks, list) or [item.get("id") for item in checks if isinstance(item, dict)] != expected_check_ids:
            raise ValueError("doctor checks are invalid")
        if any(
            set(item) != {"detail", "id", "status"}
            or item.get("status") not in {"pass", "fail"}
            or not isinstance(item.get("detail"), str)
            for item in checks
        ):
