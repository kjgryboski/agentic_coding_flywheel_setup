#!/usr/bin/env bash
set -euo pipefail
shopt -s lastpipe 2>/dev/null || true
umask 022

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/${BASH_SOURCE[0]##*/}"
STATE_HOME="${FLYWHEEL_STATE_HOME:-$HOME/.local/share/agent-flywheel}"
SOURCE_POINTER="$STATE_HOME/source-root"
INSTALL_RECEIPT="$STATE_HOME/installation.json"
VM_NAME="${FLYWHEEL_VM_NAME:-agent-flywheel-ubuntu2404}"
HEAVY_RUN="${FLYWHEEL_HEAVY_RUN:-$HOME/.local/bin/codex-heavy-run}"
LIMACTL="${FLYWHEEL_LIMACTL:-$(command -v limactl 2>/dev/null || true)}"
ROLLOUT_RECEIPT="${FLYWHEEL_ROLLOUT_RECEIPT:-}"
QUIET=0
JSON=0
NO_GUM=0
TEMP_ROOT=""
LOCK_DIR=""

cleanup() {
    if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
    if [[ -n "$TEMP_ROOT" && -d "$TEMP_ROOT" ]]; then
        rm -rf -- "$TEMP_ROOT"
    fi
}
trap cleanup EXIT INT TERM HUP

usage() {
    cat <<'USAGE'
Usage:
  flywheel mac install
  flywheel start
  flywheel status [--json] [--rollout-receipt FILE]
  flywheel doctor [--json]
  flywheel stop
  flywheel capabilities --json
  flywheel robot-docs guide
  flywheel repository inspect PATH [--json]
  flywheel rollout plan INVENTORY.json [--json]

Options:
  --json                  machine-readable read-side output
  --rollout-receipt FILE  attach one repository rollout evidence receipt
  --quiet                 suppress non-error progress
  --no-gum                disable optional gum formatting
  -h, --help              show this help

Exit codes:
  0  command completed successfully
  1  status or doctor completed and found an unhealthy state
  2  invalid invocation or safety refusal
  3  required host environment is unavailable
  5  another operation owns the requested state

The Mac command manages the supported Ubuntu VM. Native macOS is not treated
as an ACFS installation. The current installation scope is PARTIAL_SAFE: eight
approved modules are installed and all 27 licensing-held modules stay blocked.
USAGE
}

info() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
        gum style --foreground 39 "→ $*"
    else
        printf '→ %s\n' "$*"
    fi
}

ok() {
    ((QUIET == 1)) && return 0
    if ((NO_GUM == 0)) && command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
        gum style --foreground 42 "✓ $*"
    else
        printf '✓ %s\n' "$*"
    fi
}

die() {
    local code="$1"
    shift
    printf 'Flywheel: %s\n' "$*" >&2
    exit "$code"
}

find_source_root() {
    local self_dir="${SELF%/*}"
    local candidate="${FLYWHEEL_SOURCE_REPO:-}"
    if [[ -z "$candidate" && -f "$self_dir/acfs.manifest.yaml" ]]; then
        candidate="$self_dir"
    fi
    if [[ -z "$candidate" && -f "$SOURCE_POINTER" && ! -L "$SOURCE_POINTER" ]]; then
        IFS= read -r candidate <"$SOURCE_POINTER"
    fi
    [[ -n "$candidate" && "$candidate" == /* && -f "$candidate/acfs.manifest.yaml" ]] \
        || return 1
    (cd "$candidate" && pwd -P)
}

source_root() {
    find_source_root \
        || die 3 "cannot locate the ACFS source checkout; set FLYWHEEL_SOURCE_REPO"
}

require_mac_tools() {
    [[ "$(uname -s)" == "Darwin" ]] \
        || die 3 "Mac lifecycle commands require macOS"
    [[ -n "$LIMACTL" && -x "$LIMACTL" ]] \
        || die 3 "Lima is required; install it, then retry the same command"
}

vm_status() {
    "$LIMACTL" list --json | python3 -c '
import json, sys
name=sys.argv[1]
for line in sys.stdin:
    try: item=json.loads(line)
    except json.JSONDecodeError: continue
    if item.get("name") == name:
        print(item.get("status", "Unknown"))
        raise SystemExit(0)
raise SystemExit(3)
' "$VM_NAME"
}

ensure_running() {
    local status=""
    status="$(vm_status 2>/dev/null || true)"
    if [[ "$status" == "Running" ]]; then
        return 0
    fi
    [[ -x "$HEAVY_RUN" ]] \
        || die 3 "the Mac heavy-work safety guard is unavailable; restore $HEAVY_RUN, then run flywheel start"
    info "Starting the Ubuntu Flywheel"
    "$HEAVY_RUN" --stateful -- "$LIMACTL" start "$VM_NAME"
}

acquire_install_lock() {
    local lock_root="$STATE_HOME/locks"
    mkdir -p "$lock_root"
    chmod 0700 "$STATE_HOME" "$lock_root"
    LOCK_DIR="$lock_root/install.lock"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        die 5 "another Flywheel install is already running; retry flywheel mac install after it finishes"
    fi
}

sha256_file() {
    shasum -a 256 "$1" | awk '{print $1}'
}

publish_private_file() {
    local source="$1"
    local destination="$2"
    local parent="${destination%/*}"
    local name="${destination##*/}"
    local candidate=""
    [[ -d "$parent" && ! -L "$parent" ]] \
        || die 3 "state directory is unavailable or unsafe: $parent"
    candidate="$(mktemp "$parent/.$name.XXXXXXXX")"
    install -m 0600 "$source" "$candidate"
    mv -f "$candidate" "$destination"
}

stage_source() {
    local root="$1"
    local head="$2"
    local short="${head:0:12}"
    local bundle="$TEMP_ROOT/acfs-$short.bundle"
    local bundle_sha256=""
    local guest_bundle="/var/tmp/agent-flywheel-acfs-$head.bundle"
    local guest_root="/opt/agent-flywheel-acfs-$head"

    git -C "$root" bundle create "$bundle" HEAD
    bundle_sha256="$(sha256_file "$bundle")"
    "$LIMACTL" copy --backend=scp "$bundle" "$VM_NAME:$guest_bundle" >/dev/null
    "$LIMACTL" shell "$VM_NAME" -- bash -lc '
set -euo pipefail
guest_bundle="$1"
guest_root="$2"
head="$3"
if [[ ! -d "$guest_root/.git" ]]; then
    sudo git clone --quiet "$guest_bundle" "$guest_root"
fi
test "$(sudo git -C "$guest_root" rev-parse HEAD)" = "$head"
sudo git -C "$guest_root" diff --quiet
sudo git -C "$guest_root" diff --cached --quiet
test -z "$(sudo git -C "$guest_root" ls-files --others --exclude-standard)"
' -- "$guest_bundle" "$guest_root" "$head"
    printf '%s\t%s\n' "$guest_root" "$bundle_sha256"
}

write_install_receipt() {
    local root="$1"
    local head="$2"
    local tree="$3"
    local guest_root="$4"
    local bundle_sha256="$5"
    local allowlist="$root/config/flywheel-partial-safe-allowlist.json"
    local allowlist_sha256=""
    local candidate="$TEMP_ROOT/installation.json"
    allowlist_sha256="$(sha256_file "$allowlist")"
    python3 - "$head" "$tree" "$guest_root" "$bundle_sha256" "$allowlist_sha256" "$allowlist" <<'PY' >"$candidate"
import datetime
import json
import sys

head, tree, guest_root, bundle_sha256, allowlist_sha256, allowlist_path = sys.argv[1:]
with open(allowlist_path, encoding="utf-8") as handle:
    allowlist = json.load(handle)
print(json.dumps({
    "schema": "agent-flywheel.installation/v1",
    "claim": "PARTIAL_SAFE",
    "installed_at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat(),
    "source": {"head": head, "tree": tree, "guest_root": guest_root},
    "bundle": {"sha256": bundle_sha256},
    "allowlist": {"sha256": allowlist_sha256},
    "modules": {
        "approved": len(allowlist["allowed_resolved_modules"]),
        "licensing_held": allowlist["held_exclusions"]["count"],
    },
}, sort_keys=True, separators=(",", ":")))
PY
    publish_private_file "$candidate" "$INSTALL_RECEIPT"
}

install_command() {
    require_mac_tools
    local root=""
    local head=""
    local tree=""
    local guest_root=""
    local bundle_sha256=""
    local stage_result=""
    root="$(source_root)"
    git -C "$root" diff --quiet \
        || die 2 "source checkout has uncommitted changes; commit or preserve them before flywheel mac install"
    git -C "$root" diff --cached --quiet \
        || die 2 "source checkout has staged changes; commit or preserve them before flywheel mac install"
    [[ -z "$(git -C "$root" ls-files --others --exclude-standard)" ]] \
        || die 2 "source checkout has untracked files; preserve them before flywheel mac install"
    head="$(git -C "$root" rev-parse HEAD)"
    tree="$(git -C "$root" rev-parse 'HEAD^{tree}')"

    acquire_install_lock
    TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/flywheel-install.XXXXXXXX")"
    ensure_running
    info "Staging exact source $head"
    stage_result="$(stage_source "$root" "$head")"
    IFS=$'\t' read -r guest_root bundle_sha256 <<<"$stage_result"
    [[ -n "$guest_root" && -n "$bundle_sha256" ]] \
        || die 3 "exact-source staging produced no identity; rerun flywheel mac install"
    info "Commissioning the eight-module PARTIAL_SAFE profile"
    "$HEAVY_RUN" --stateful -- "$LIMACTL" shell "$VM_NAME" -- \
        sudo bash -p "$guest_root/scripts/flywheel-mac-install-guest.sh" "$guest_root"

    mkdir -p "$STATE_HOME" "$HOME/.local/bin"
    chmod 0700 "$STATE_HOME"
    printf '%s\n' "$root" >"$TEMP_ROOT/source-root"
    publish_private_file "$TEMP_ROOT/source-root" "$SOURCE_POINTER"
    write_install_receipt "$root" "$head" "$tree" "$guest_root" "$bundle_sha256"
    install -m 0755 "$SELF" "$HOME/.local/bin/flywheel"
    ok "Flywheel is installed on Ubuntu and available as flywheel"
}

start_command() {
    require_mac_tools
    if [[ "$(vm_status 2>/dev/null || true)" == "Running" ]]; then
        ok "Flywheel is already running"
    else
        ensure_running
        ok "Flywheel is running"
    fi
}

status_command() {
    require_mac_tools
    local status=""
    local root=""
    local head=""
    local tree=""
    local source_clean="false"
    local allowlist=""
    local qualification_json=""
    local doctor_json=""
    local status_json=""
    status="$(vm_status 2>/dev/null || true)"
    [[ -n "$status" ]] || status="Missing"
    root="$(find_source_root 2>/dev/null || true)"
    if [[ -n "$root" ]]; then
        head="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
        tree="$(git -C "$root" rev-parse 'HEAD^{tree}' 2>/dev/null || true)"
        allowlist="$root/config/flywheel-partial-safe-allowlist.json"
        if git -C "$root" diff --quiet \
            && git -C "$root" diff --cached --quiet \
            && [[ -z "$(git -C "$root" ls-files --others --exclude-standard)" ]]; then
            source_clean="true"
        fi
    fi
    if [[ "$status" == "Running" && -n "$root" && -n "$head" ]]; then
        set +e
        qualification_json="$(qualification_command "$head" 2>/dev/null)"
        doctor_json="$(doctor_command --json-internal 2>/dev/null)"
        set -e
    fi
    status_json="$(python3 - "$VM_NAME" "$status" "$root" "$head" "$tree" "$source_clean" "$INSTALL_RECEIPT" "$allowlist" "$ROLLOUT_RECEIPT" "$qualification_json" "$doctor_json" <<'PY'
import hashlib
import json
import pathlib
import sys

(
    vm_name,
    vm_status,
    source_root,
    source_head,
    source_tree,
    source_clean_raw,
    install_receipt_path,
    allowlist_path,
    rollout_receipt_path,
    qualification_raw,
    doctor_raw,
) = sys.argv[1:]

def read_json(path):
    if not path:
        return None
    try:
        candidate = pathlib.Path(path)
        if candidate.is_symlink() or not candidate.is_file():
            return None
        return json.loads(candidate.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None

def is_hex(value, length):
    return isinstance(value, str) and len(value) == length and all(character in "0123456789abcdef" for character in value)

def parse_json(raw, schema):
    if raw:
        try:
            value = json.loads(raw)
            if isinstance(value, dict):
                return value
        except json.JSONDecodeError:
            pass
    return {"schema": schema, "status": "not_run"}

allowlist = read_json(allowlist_path) or {}
approved = allowlist.get("allowed_resolved_modules", [])
held = allowlist.get("held_exclusions", {})
try:
    current_allowlist_sha256 = hashlib.sha256(pathlib.Path(allowlist_path).read_bytes()).hexdigest()
except OSError:
    current_allowlist_sha256 = None
installation_raw = read_json(install_receipt_path)
if not isinstance(installation_raw, dict):
    installation = {
        "schema": "agent-flywheel.installation/v1",
        "status": "receipt_missing",
    }
else:
    receipt_source = installation_raw.get("source", {})
    receipt_bundle = installation_raw.get("bundle", {})
    receipt_allowlist = installation_raw.get("allowlist", {})
    receipt_modules = installation_raw.get("modules", {})
    receipt_valid = bool(
        installation_raw.get("schema") == "agent-flywheel.installation/v1"
        and installation_raw.get("claim") == "PARTIAL_SAFE"
        and isinstance(receipt_source, dict)
        and is_hex(receipt_source.get("head"), 40)
        and is_hex(receipt_source.get("tree"), 40)
        and receipt_source.get("guest_root") == f"/opt/agent-flywheel-acfs-{receipt_source.get('head')}"
        and isinstance(receipt_bundle, dict)
        and is_hex(receipt_bundle.get("sha256"), 64)
        and isinstance(receipt_allowlist, dict)
        and is_hex(receipt_allowlist.get("sha256"), 64)
        and isinstance(receipt_modules, dict)
        and receipt_modules.get("approved") == len(approved)
        and receipt_modules.get("licensing_held") == held.get("count")
    )
    installation = {
        "schema": "agent-flywheel.installation/v1",
        "status": "recorded" if receipt_valid else "receipt_invalid",
        "claim": installation_raw.get("claim"),
        "installed_at": installation_raw.get("installed_at"),
        "source": {
            "head": receipt_source.get("head"),
            "tree": receipt_source.get("tree"),
            "guest_root": receipt_source.get("guest_root"),
        },
        "bundle": {"sha256": receipt_bundle.get("sha256")},
        "allowlist": {"sha256": receipt_allowlist.get("sha256")},
        "modules": {
            "approved": receipt_modules.get("approved"),
            "licensing_held": receipt_modules.get("licensing_held"),
        },
    }

qualification = parse_json(qualification_raw, "agent-flywheel.qualification-host/v1")
doctor = parse_json(doctor_raw, "agent-flywheel.partial-safe-doctor/v1")

recorded_source = installation.get("source", {})
source_exact = bool(
    source_head
    and source_tree
    and recorded_source.get("head") == source_head
    and recorded_source.get("tree") == source_tree
)
source_clean = source_clean_raw == "true"
allowlist_exact = bool(
    current_allowlist_sha256
    and installation.get("allowlist", {}).get("sha256") == current_allowlist_sha256
)
installation["matches_current_allowlist"] = allowlist_exact

rollout = {"status": "not_connected"}
if rollout_receipt_path:
    path = pathlib.Path(rollout_receipt_path)
    try:
        if path.is_symlink() or not path.is_file():
            raise ValueError("receipt must be a regular non-symlink file")
        raw = path.read_bytes()
        value = json.loads(raw)
        if not isinstance(value, dict):
            raise ValueError("receipt root is not an object")
        schema = value.get("schema")
        if schema == "agent-flywheel.repository-rollout/v1":
            if (
                not isinstance(value.get("status"), str)
                or not isinstance(value.get("scope"), str)
                or not isinstance(value.get("repository"), str)
                or not isinstance(value.get("bookclub_eligible"), bool)
            ):
                raise ValueError("repository rollout receipt fields are invalid")
            rollout = {
                "status": "evidence_connected",
                "receipt_sha256": hashlib.sha256(raw).hexdigest(),
                "schema": schema,
                "declared_status": value["status"],
                "scope": value["scope"],
                "repository": value["repository"],
                "bookclub_eligible": value["bookclub_eligible"],
            }
        elif schema == "agent-flywheel.progressive-rollout-plan/v1":
            plan_digest = value.get("plan_sha256")
            digest_source = dict(value)
            digest_source.pop("plan_sha256", None)
            observed_plan_digest = hashlib.sha256(
                (json.dumps(digest_source, sort_keys=True, separators=(",", ":")) + "\n").encode()
            ).hexdigest()
            cohorts = value.get("cohorts")
            if (
                not isinstance(plan_digest, str)
                or plan_digest != observed_plan_digest
                or not isinstance(cohorts, list)
                or not cohorts
                or any(not isinstance(item, dict) or not isinstance(item.get("repository"), dict) for item in cohorts)
            ):
                raise ValueError("progressive rollout plan content binding is invalid")
            repositories = [item["repository"] for item in cohorts]
            rollout = {
                "status": "evidence_connected",
                "receipt_sha256": hashlib.sha256(raw).hexdigest(),
                "schema": schema,
                "declared_status": value.get("status"),
                "scope": "plan-only",
                "execution_status": value.get("execution_status"),
                "mutation_authorized": value.get("mutation_authorized"),
                "repository": repositories[0] if len(repositories) == 1 else None,
                "repositories": repositories,
                "repository_count": len(repositories),
                "setup_pr_eligible": all(item.get("setup_pr_eligible") is True for item in cohorts),
                "live_rollout_eligible": all(item.get("live_rollout_eligible") is True for item in cohorts),
                "bookclub_eligible": None,
            }
        else:
            raise ValueError("unsupported rollout receipt schema")
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        rollout = {"status": "invalid", "error": str(error)}

blockers = []
if vm_status != "Running":
    blockers.append({"scope": "lifecycle", "code": "vm_not_running", "next_command": "flywheel start"})
if not source_root:
    blockers.append({"scope": "lifecycle", "code": "source_unavailable", "next_command": "set FLYWHEEL_SOURCE_REPO, then run flywheel status"})
elif not source_clean:
    blockers.append({"scope": "lifecycle", "code": "source_dirty", "next_command": "preserve source changes, then run flywheel status"})
if installation.get("status") == "receipt_missing":
    blockers.append({"scope": "lifecycle", "code": "installation_receipt_missing", "next_command": "flywheel mac install"})
elif installation.get("status") != "recorded":
    blockers.append({"scope": "lifecycle", "code": "installation_receipt_invalid", "next_command": "flywheel mac install"})
elif not source_exact:
    blockers.append({"scope": "lifecycle", "code": "installed_source_drift", "next_command": "flywheel mac install"})
elif not allowlist_exact:
    blockers.append({"scope": "lifecycle", "code": "installed_allowlist_drift", "next_command": "flywheel mac install"})
if vm_status == "Running" and qualification.get("status") != "pass":
    blockers.append({"scope": "qualification", "code": "host_contract_failed", "next_command": "flywheel status --json"})
if vm_status == "Running" and doctor.get("status") != "pass":
    blockers.append({"scope": "doctor", "code": "doctor_failed", "next_command": "flywheel doctor --json"})
if rollout.get("status") == "not_connected":
    blockers.append({"scope": "repository_rollout", "code": "receipt_not_connected", "next_command": "flywheel status --json --rollout-receipt FILE"})
elif rollout.get("status") == "invalid":
    blockers.append({"scope": "repository_rollout", "code": "receipt_invalid", "next_command": "supply a valid JSON rollout receipt"})
elif rollout.get("scope") != "live-repository-rollout":
    blockers.append({"scope": "repository_rollout", "code": "live_rollout_not_proven", "next_command": "attach a passing live-repository-rollout receipt after explicit authorization"})
elif rollout.get("declared_status") != "pass":
    blockers.append({"scope": "repository_rollout", "code": "rollout_receipt_not_passing", "next_command": "repair the rollout evidence, then attach a passing receipt"})

lifecycle_blocked = any(item["scope"] != "repository_rollout" for item in blockers)
value = {
    "schema": "agent-flywheel.status/v2",
    "claim": "PARTIAL_SAFE",
    "status": vm_status,
    "readiness": "attention" if lifecycle_blocked else "ready",
    "vm": {"name": vm_name, "status": vm_status, "healthy": vm_status == "Running"},
    "source": {
        "root": source_root or None,
        "head": source_head or None,
        "tree": source_tree or None,
        "clean": source_clean,
        "matches_installation": source_exact,
    },
    "installation": installation,
    "modules": {
        "approved": approved,
        "approved_count": len(approved),
        "licensing_held_count": held.get("count", 0),
        "licensing_held_set_sha256": held.get("canonical_set_sha256"),
        "pending_licensing_approvals": held.get("count", 0),
    },
    "qualification": qualification,
    "doctor": doctor,
    "repository_rollout": rollout,
    "blockers": blockers,
    "commands": {
        "install": "flywheel mac install",
        "start": "flywheel start",
        "status": "flywheel status --json",
        "doctor": "flywheel doctor --json",
        "stop": "flywheel stop",
    },
}
print(json.dumps(value, sort_keys=True, separators=(",", ":")))
PY
)"
    if ((JSON == 1)); then
        printf '%s\n' "$status_json"
    else
        python3 -c '
import json,sys
value=json.loads(sys.argv[1])
print(f"Flywheel: {value[\"readiness\"]}")
print(f"VM: {value[\"vm\"][\"name\"]} ({value[\"vm\"][\"status\"]})")
print(f"Source: {value[\"source\"][\"head\"] or \"unavailable\"}")
print(f"Modules: {value[\"modules\"][\"approved_count\"]} approved; {value[\"modules\"][\"pending_licensing_approvals\"]} licensing approvals pending")
print(f"Qualification: {value[\"qualification\"].get(\"status\", \"not_run\")}")
print(f"Doctor: {value[\"doctor\"].get(\"status\", \"not_run\")}")
print(f"Repository rollout: {value[\"repository_rollout\"][\"status\"]}")
for blocker in value["blockers"]:
    print(f"Blocker [{blocker[\"scope\"]}]: {blocker[\"code\"]} -> {blocker[\"next_command\"]}")
' "$status_json"
    fi
    python3 -c 'import json,sys; raise SystemExit(0 if json.loads(sys.argv[1])["readiness"] == "ready" else 1)' "$status_json"
}

qualification_command() {
    local head="$1"
    local guest_root="/opt/agent-flywheel-acfs-$head"
    "$LIMACTL" shell "$VM_NAME" -- sudo -u ubuntu env \
        HOME=/home/ubuntu \
        PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        FLYWHEEL_SOURCE_ROOT="$guest_root" \
        bash -p "$guest_root/scripts/flywheel-qualification-host.sh" --json
}

doctor_command() {
    local force_json="${1:-}"
    require_mac_tools
    [[ "$(vm_status 2>/dev/null || true)" == "Running" ]] \
        || die 1 "Flywheel is stopped; run flywheel start, then flywheel doctor"
    local root=""
    local head=""
    local guest_root=""
    local doctor_args=()
    root="$(source_root)"
    head="$(git -C "$root" rev-parse HEAD)"
    guest_root="/opt/agent-flywheel-acfs-$head"
    if ((JSON == 1)) || [[ "$force_json" == "--json-internal" ]]; then
        doctor_args+=(--json)
    fi
    "$LIMACTL" shell "$VM_NAME" -- sudo -u ubuntu env \
        HOME=/home/ubuntu \
        PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        TARGET_USER=ubuntu \
        TARGET_HOME=/home/ubuntu \
        FLYWHEEL_SOURCE_ROOT="$guest_root" \
        ACFS_PARTIAL_SAFE_ALLOWLIST_FILE=/var/lib/agent-flywheel/doctor-allowlist.json \
        bash -p "$guest_root/scripts/flywheel-partial-safe-doctor.sh" "${doctor_args[@]}"
}

stop_command() {
    require_mac_tools
    if [[ "$(vm_status 2>/dev/null || true)" != "Running" ]]; then
        ok "Flywheel is already stopped"
        return 0
    fi
    info "Stopping the Ubuntu Flywheel cleanly"
    "$LIMACTL" stop "$VM_NAME"
    ok "Flywheel is stopped"
}

