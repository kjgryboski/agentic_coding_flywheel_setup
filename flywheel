qualification_command() {
    local head="$1"
    local guest_root="/opt/agent-flywheel-acfs-$head"
    "$LIMACTL" shell "$VM_NAME" -- sudo -u ubuntu env \
        HOME=/home/ubuntu \
        PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        FLYWHEEL_SOURCE_ROOT="$guest_root" \
        bash -p "$guest_root/scripts/flywheel-qualification-host.sh" --json
}

doctor_command() {
    local force_json="${1:-}"
    local probe=""
    require_mac_tools
    probe="$(vm_probe)"
    [[ "$(probe_value "$probe" '["query_status"]')" == "ok" ]] \
        || die 3 "cannot query Lima VM inventory; doctor did not run"
    [[ "$(probe_value "$probe" '["exists"]')" == "true" \
        && "$(probe_value "$probe" '["status"]')" == "Running" ]] \
        || die 1 "Flywheel is stopped; run flywheel start, then flywheel doctor"
    [[ "$(probe_value "$probe" '["contract"]["matches"]')" == "true" ]] \
        || die 2 "existing VM $VM_NAME does not match the Flywheel contract ($(probe_value "$probe" '["mismatches"]')); doctor did not run"
    local root=""
    local head=""
    local guest_root=""
    # Bash 3.2 with nounset treats expansion of an empty array as unbound.
    # Keep a sentinel and slice it away so the plain command passes zero args.
    local doctor_args=(__flywheel_sentinel__)
    local authority_env=(ACFS_PARTIAL_SAFE_ALLOWLIST_FILE=/var/lib/agent-flywheel/doctor-allowlist.json)
    root="$(source_root)"
    head="$(git -C "$root" rev-parse HEAD)"
    guest_root="/opt/agent-flywheel-acfs-$head"
    if [[ -f "$root/config/flywheel-license-clearance.json" ]]; then
        authority_env=(ACFS_LICENSE_CLEARANCE_FILE=/var/lib/agent-flywheel/doctor-license-clearance.json)
    fi
    if ((JSON == 1)) || [[ "$force_json" == "--json-internal" ]]; then
        doctor_args+=(--json)
    fi
    "$LIMACTL" shell "$VM_NAME" -- sudo -u ubuntu env \
        HOME=/home/ubuntu \
        PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        TARGET_USER=ubuntu \
        TARGET_HOME=/home/ubuntu \
        FLYWHEEL_SOURCE_ROOT="$guest_root" \
        "${authority_env[@]}" \
        bash -p "$guest_root/scripts/flywheel-partial-safe-doctor.sh" "${doctor_args[@]:1}"
}

stop_command() {
    local probe=""
    require_mac_tools
    probe="$(vm_probe)"
    [[ "$(probe_value "$probe" '["query_status"]')" == "ok" ]] \
        || die 3 "cannot query Lima VM inventory; no VM was stopped"
    if [[ "$(probe_value "$probe" '["exists"]')" != "true" \
        || "$(probe_value "$probe" '["status"]')" != "Running" ]]; then
        ok "Flywheel is already stopped"
        return 0
    fi
    info "Stopping the Ubuntu Flywheel cleanly"
    "$LIMACTL" stop "$VM_NAME"
    ok "Flywheel is stopped"
}

