install_command() {
    require_mac_tools
    local root=""
    local source_cli=""
    local committed_cli=""
    local installed_cli="$HOME/.local/bin/flywheel"
    local head=""
    local tree=""
    local guest_root=""
    local bundle_sha256=""
    local stage_result=""
    root="$(source_root)"
    source_cli="$root/flywheel"
    [[ -f "$source_cli" && ! -L "$source_cli" ]] \
        || die 2 "source checkout has no regular flywheel launcher"
    git_index_flags_safe "$root" \
        || die 2 "source checkout has unsafe assume-unchanged, skip-worktree, or unmerged index flags"
    head="$(safe_git -C "$root" rev-parse --verify HEAD)"
    tree="$(safe_git -C "$root" rev-parse 'HEAD^{tree}')"
    tracked_regular_files_match_head "$root" "$head" \
        || die 2 "source checkout bytes differ from the exact committed tree; commit or preserve them before flywheel mac install"
    safe_git -C "$root" diff --cached --quiet --no-ext-diff --no-textconv \
        || die 2 "source checkout has staged changes; commit or preserve them before flywheel mac install"
    [[ -z "$(safe_git -C "$root" ls-files --others --exclude-standard)" ]] \
        || die 2 "source checkout has untracked files; preserve them before flywheel mac install"
    [[ "$(safe_git -C "$root" rev-parse --verify HEAD)" == "$head" \
        && "$(safe_git -C "$root" rev-parse 'HEAD^{tree}')" == "$tree" ]] \
        || die 2 "source checkout changed while its exact identity was being verified"

    acquire_lifecycle_lock "mac install"
    ensure_temp_root
    ensure_running
    info "Staging exact source $head"
    stage_result="$(stage_source "$root" "$head" "$tree")"
    IFS=$'\t' read -r guest_root bundle_sha256 <<<"$stage_result"
    [[ -n "$guest_root" && -n "$bundle_sha256" ]] \
        || die 3 "exact-source staging produced no identity; rerun flywheel mac install"
    if safe_git -C "$root" cat-file -e "$head:config/flywheel-license-clearance.json" 2>/dev/null; then
        info "Commissioning the license-cleared profile with independent holds preserved"
    else
        info "Commissioning the eight-module PARTIAL_SAFE profile"
    fi
    verify_guest_source "$guest_root" "$head" "$tree" || return 1
    "$HEAVY_RUN" --stateful -- "$LIMACTL" shell "$VM_NAME" -- \
        sudo /bin/bash -p "$guest_root/scripts/flywheel-mac-install-guest.sh" "$guest_root"

    /bin/mkdir -p "$STATE_HOME" "$HOME/.local/bin"
    /bin/chmod 0700 "$STATE_HOME"
    printf '%s\n' "$root" >"$TEMP_ROOT/source-root"
    publish_private_file "$TEMP_ROOT/source-root" "$SOURCE_POINTER"
    write_install_receipt "$root" "$head" "$tree" "$guest_root" "$bundle_sha256"
    committed_cli="$TEMP_ROOT/installed-flywheel"
    safe_git -C "$root" show "$head:flywheel" >"$committed_cli"
    /bin/chmod 0500 "$committed_cli"
    /usr/bin/install -m 0755 "$committed_cli" "$installed_cli"
    ok "Flywheel is installed on Ubuntu and available as flywheel"
}

start_command() {
    require_mac_tools
    acquire_lifecycle_lock "start"
    ensure_running
    ok "Flywheel is running"
}

